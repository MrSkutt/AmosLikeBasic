<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The interpreter's main loop is a big method. With this it is compiled optimised straight
             away instead of running slowly for the first moments of every program run (~45 ms extra).
             Costs about 50 ms longer app start-up. -->
        <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>

        <!-- We use RuntimeIdentifiers (plural) to support both platforms -->
        <RuntimeIdentifiers>osx-arm64;win-x64</RuntimeIdentifiers>
        <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</RuntimeIdentifier>
        <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>

        <!-- The test project, the libraries and the stand-alone tracker live in folders under this one
             and must not be compiled into the app -->
        <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**;AmosLikeBasic.Core/**;AmosLikeBasic.Tracker/**;AmosTracker/**</DefaultItemExcludes>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationIcon>Assets/AmosLikeBasic.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6" />
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
        <PackageReference Include="ManagedBass" Version="3.1.4" />
        <PackageReference Include="ManagedBass.Mix" Version="3.1.4" />
        <PackageReference Include="SDL2-CS.NetCore" Version="2.0.8" />
        <PackageReference Include="SkiaSharp" Version="3.119.4" />
        <PackageReference Include="Un4seen.Bass" Version="2.4.18.2" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AmosLikeBasic.Tests" />
    </ItemGroup>

    <!-- The engine (synth, songs, file readers) and the tracker, shared with the stand-alone tracker -->
    <ItemGroup>
        <ProjectReference Include="AmosLikeBasic.Core/AmosLikeBasic.Core.csproj" />
        <ProjectReference Include="AmosLikeBasic.Tracker/AmosLikeBasic.Tracker.csproj" />
    </ItemGroup>

    <!-- Resources -->
    <ItemGroup>
        <!-- Not the user's own music collections or the samples written when a module is read (all gitignored) -->
        <None Include="Sound/**/*" Exclude="Sound/Tracker/YM/**;Sound/Tracker/SNDH/**;Sound/AtariYM/**;Sound/Samples/*/**" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Graphics/**/*" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Projects/**/*" CopyToOutputDirectory="PreserveNewest" />
        <!-- Retro fonts for FONT SET (C64 Pro Mono, Topaz ...), so the text looks the same on every computer -->
        <None Include="fonts/**/*" CopyToOutputDirectory="PreserveNewest" />
        <!-- The reference chapters of the manual, for help in the code editor (F1, hovering) -->
        <EmbeddedResource Include="Documentation/Manual/42-commands.md" LogicalName="Manual.42-commands.md" />
        <EmbeddedResource Include="Documentation/Manual/43-functions.md" LogicalName="Manual.43-functions.md" />
    </ItemGroup>

    <!-- Native libraries for Windows -->
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
        <None Include="libs/windows/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>

    <!-- Native libraries for macOS -->
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
        <None Include="libs/mac/*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>
</Project>
