<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AmosLikeBasic.TilePaletteWindow"
        Title="Tile Palette" Width="300" Height="600"
        Background="{DynamicResource AmosCanvasBg}" WindowStartupLocation="CenterOwner"
        Topmost="True">
    <Border Margin="2" BorderBrush="{DynamicResource AmosPanelBorder}" BorderThickness="1">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <!-- A grid that we fill in entirely by hand from C# -->
            <Canvas Name="PaletteCanvas" Background="{DynamicResource AmosCanvasBg}" />
        </ScrollViewer>
    </Border>
</Window>