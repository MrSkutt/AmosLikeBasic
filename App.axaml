<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             x:Class="AmosLikeBasic.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- Theme colours. Set by ThemeResources.Apply when a theme is chosen; this is Classic Blue. -->
    <Application.Styles>
        <FluentTheme />

        <!-- The AMOS look: theme colours and styles, shared with the stand-alone tracker -->
        <StyleInclude Source="avares://AmosLikeBasic.Tracker/AmosStyles.axaml" />

        <!-- IMPORTANT: This line loads AvaloniaEdit so that it works! -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Updated style for TextEditor -->
        <Style Selector="avaloniaEdit|TextEditor.amos-editor">
            <Setter Property="FontFamily" Value="Courier New, Monospace"/>
            <Setter Property="Background" Value="#00134D"/>
            <Setter Property="Foreground" Value="#7FB2FF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Application.Styles>
</Application>
