<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             x:Class="AmosLikeBasic.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- Temafärger. Sätts av ThemeResources.Apply när ett tema väljs; detta är Classic Blue. -->
    <Application.Resources>
        <SolidColorBrush x:Key="AmosWindowBg" Color="#0B2A9B"/>
        <SolidColorBrush x:Key="AmosPanelBg" Color="#06206F"/>
        <SolidColorBrush x:Key="AmosPanelBorder" Color="#7FB2FF"/>
        <SolidColorBrush x:Key="AmosLabelFg" Color="#7FB2FF"/>
        <SolidColorBrush x:Key="AmosTitleFg" Color="#FFD400"/>
        <SolidColorBrush x:Key="AmosInputBg" Color="#00134D"/>
        <SolidColorBrush x:Key="AmosInputFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AmosCanvasBg" Color="#00134D"/>
        <SolidColorBrush x:Key="AmosButtonBg" Color="#0A2D8F"/>
        <SolidColorBrush x:Key="AmosButtonFg" Color="#FFFFFF"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        
        <!-- VIKTIGT: Denna rad laddar AvaloniaEdit så att den fungerar! -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- AMOS-ish palette + chunky controls -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AmosWindowBg}"/>
        </Style>

        <Style Selector="Border.amos-panel">
            <Setter Property="Background" Value="{DynamicResource AmosPanelBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AmosPanelBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <!-- Uppdaterad stil för TextEditor -->
        <Style Selector="avaloniaEdit|TextEditor.amos-editor">
            <Setter Property="FontFamily" Value="Courier New, Monospace"/>
            <Setter Property="Background" Value="#00134D"/>
            <Setter Property="Foreground" Value="#7FB2FF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="TextBox.amos-console">
            <Setter Property="FontFamily" Value="Courier New, Monospace"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <!-- Tvinga bort scrollbarer helt -->
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style Selector="Button.amos-button">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AmosPanelBorder}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style Selector="Menu">
            <Setter Property="Background" Value="#08237F"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="TextBlock.amos-title">
            <Setter Property="Foreground" Value="{DynamicResource AmosTitleFg}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Foreground" Value="{DynamicResource AmosInputFg}" />
            <Setter Property="Background" Value="{DynamicResource AmosInputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AmosPanelBorder}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!-- Etiketter i editorernas paneler -->
        <Style Selector="TextBlock.amos-label">
            <Setter Property="Foreground" Value="{DynamicResource AmosLabelFg}"/>
        </Style>
    </Application.Styles>
</Application>