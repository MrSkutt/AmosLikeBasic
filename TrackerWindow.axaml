<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AmosLikeBasic"
        x:Class="AmosLikeBasic.TrackerWindow"
        Title="Tracker" Width="1280" Height="820" MinWidth="900" MinHeight="500"
        Background="{DynamicResource AmosCanvasBg}">
    <Window.Styles>
        <Style Selector="ListBox.tracker-list ListBoxItem">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AmosInputFg}"/>
        </Style>
    </Window.Styles>
    <DockPanel>
        <!-- Verktygsrad -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AmosPanelBg}" BorderBrush="{DynamicResource AmosPanelBorder}" BorderThickness="0,0,0,2" Padding="6">
            <WrapPanel Orientation="Horizontal">
                <Button Content="NEW" Classes="amos-button" Click="New_OnClick" Focusable="False" Margin="0,0,4,0"/>
                <Button Content="LOAD" Classes="amos-button" Click="Load_OnClick" Focusable="False" Margin="0,0,4,0"/>
                <Button Content="SAVE" Classes="amos-button" Click="Save_OnClick" Focusable="False" Margin="0,0,4,0"/>
                <Button Content="SAVE AS" Classes="amos-button" Click="SaveAs_OnClick" Focusable="False" Margin="0,0,14,0"/>
                <Button Content="PLAY SONG" Classes="amos-button" Click="PlaySong_OnClick" Focusable="False" Margin="0,0,4,0" ToolTip.Tip="F5"/>
                <Button Content="PLAY PATTERN" Classes="amos-button" Click="PlayPattern_OnClick" Focusable="False" Margin="0,0,4,0" ToolTip.Tip="F6"/>
                <Button Content="STOP" Classes="amos-button" Click="Stop_OnClick" Focusable="False" Margin="0,0,14,0" ToolTip.Tip="Esc"/>
                <ToggleButton Name="EditToggle" Content="EDIT" Classes="amos-button" IsChecked="True" Focusable="False" Margin="0,0,4,0"
                              Click="EditToggle_OnClick" ToolTip.Tip="Space"/>
                <CheckBox Name="FollowCheck" Content="Follow" IsChecked="True" Focusable="False" Margin="4,0,14,0" Foreground="{DynamicResource AmosLabelFg}"/>

                <TextBlock Text="Title" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Name="TitleBox" Width="140" Margin="0,0,12,0"/>
                <TextBlock Text="Speed" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <NumericUpDown Name="SpeedBox" Minimum="1" Maximum="31" Increment="1" FormatString="0" Width="110" Margin="0,0,8,0"/>
                <TextBlock Text="Tempo" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <NumericUpDown Name="TempoBox" Minimum="32" Maximum="255" Increment="1" FormatString="0" Width="110" Margin="0,0,8,0"/>
                <TextBlock Text="Octave" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <NumericUpDown Name="OctaveBox" Minimum="0" Maximum="8" Increment="1" FormatString="0" Width="110" Margin="0,0,8,0" ToolTip.Tip="F1 / F2"/>
                <TextBlock Text="Step" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <NumericUpDown Name="StepBox" Minimum="0" Maximum="16" Increment="1" FormatString="0" Width="110"/>
            </WrapPanel>
        </Border>

        <!-- Statusrad -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AmosPanelBg}" BorderBrush="{DynamicResource AmosPanelBorder}" BorderThickness="0,2,0,0" Padding="8,4">
            <TextBlock Name="StatusText" Classes="amos-label" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Vänster: ordningslista och mönster -->
        <Border DockPanel.Dock="Left" Width="200" Background="{DynamicResource AmosPanelBg}" BorderBrush="{DynamicResource AmosPanelBorder}" BorderThickness="0,0,2,0">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <TextBlock Text="ORDER" Classes="amos-title" HorizontalAlignment="Center"/>
                    <UniformGrid Columns="2">
                        <Button Margin="2,0" Content="INS" Classes="amos-button" Click="OrderInsert_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Insert a position after the selected one"/>
                        <Button Margin="2,0" Content="DEL" Classes="amos-button" Click="OrderDelete_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <Button Margin="2,0" Content="PAT -" Classes="amos-button" Click="OrderPatternDown_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Margin="2,0" Content="PAT +" Classes="amos-button" Click="OrderPatternUp_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Past the last pattern a new empty pattern is made"/>
                    </UniformGrid>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
                    <TextBlock Text="PATTERN" Classes="amos-title" HorizontalAlignment="Center"/>
                    <Button Content="CLONE PATTERN" Classes="amos-button" Click="ClonePattern_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Copy the pattern to a new one and use it here"/>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="Rows" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <NumericUpDown Grid.Column="1" Name="RowsBox" Minimum="1" Maximum="256" Increment="16" FormatString="0"/>
                    </Grid>
                </StackPanel>
                <ListBox Name="OrderList" Classes="tracker-list" Margin="0,8,0,0" Background="{DynamicResource AmosInputBg}" FontFamily="Menlo, Consolas, Courier New, monospace"/>
            </DockPanel>
        </Border>

        <!-- Höger: instrument -->
        <Border DockPanel.Dock="Right" Width="330" Background="{DynamicResource AmosPanelBg}" BorderBrush="{DynamicResource AmosPanelBorder}" BorderThickness="2,0,0,0">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <TextBlock Text="INSTRUMENTS" Classes="amos-title" HorizontalAlignment="Center"/>
                    <UniformGrid Columns="3">
                        <Button Margin="2,0" Content="ADD" Classes="amos-button" Click="InstAdd_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Margin="2,0" Content="CLONE" Classes="amos-button" Click="InstClone_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Margin="2,0" Content="DEL" Classes="amos-button" Click="InstDelete_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </UniformGrid>
                    <ListBox Name="InstrumentList" Classes="tracker-list" Height="190" Background="{DynamicResource AmosInputBg}" FontFamily="Menlo, Consolas, Courier New, monospace"/>
                </StackPanel>
                <ScrollViewer Margin="0,8,0,0">
                    <StackPanel Name="InstrumentPanel" Spacing="4"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Mitten: mönstret -->
        <local:PatternView Name="Pattern"/>
    </DockPanel>
</Window>
