<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AmosLikeBasic"
        x:Class="AmosLikeBasic.TrackerWindow"
        Title="Tracker" Width="1280" Height="820" MinWidth="900" MinHeight="500"
        Background="{DynamicResource AmosCanvasBg}">
    <Window.Styles>
        <Style Selector="ListBox.tracker-list ListBoxItem">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AmosInputFg}"/>
        </Style>
    </Window.Styles>
    <DockPanel>
        <!-- Verktygsrad -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AmosPanelBg}" BorderBrush="{DynamicResource AmosPanelBorder}" BorderThickness="0,0,0,2" Padding="6">
            <StackPanel Spacing="6">
            <WrapPanel Orientation="Horizontal">
                <Button Content="NEW" Classes="amos-button" Click="New_OnClick" Focusable="False" Margin="0,0,4,0"/>
                <Button Content="LOAD" Classes="amos-button" Click="Load_OnClick" Focusable="False" Margin="0,0,4,0"/>
                <Button Content="SAVE" Classes="amos-button" Click="Save_OnClick" Focusable="False" Margin="0,0,4,0"/>
                <Button Content="SAVE AS" Classes="amos-button" Click="SaveAs_OnClick" Focusable="False"/>
                <Button Name="ExportWavButton" Content="WAV" Classes="amos-button" Click="ExportWav_OnClick" Focusable="False" Margin="0,0,14,0"
                        ToolTip.Tip="Save the song as a sound file (WAV), as you hear it: muted channels are left out"/>
                <Button Content="PLAY SONG" Classes="amos-button" Click="PlaySong_OnClick" Focusable="False" Margin="0,0,4,0" ToolTip.Tip="F5"/>
                <Button Content="PLAY PATTERN" Classes="amos-button" Click="PlayPattern_OnClick" Focusable="False" Margin="0,0,4,0" ToolTip.Tip="F6"/>
                <Button Content="STOP" Classes="amos-button" Click="Stop_OnClick" Focusable="False" Margin="0,0,4,0" ToolTip.Tip="Esc"/>
                <Button Content="PANIC" Classes="amos-button" Click="Panic_OnClick" Focusable="False" Margin="0,0,14,0" Foreground="#FF5050"
                        ToolTip.Tip="Silence everything at once: the song, notes that hang, sound effects and echoes"/>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Name="EditToggle" Content="EDIT" Classes="amos-button" IsChecked="False" Focusable="False" Margin="0,0,4,0"
                                  Click="EditToggle_OnClick" ToolTip.Tip="Space"/>
                    <CheckBox Name="FollowCheck" Content="Follow" IsChecked="True" Focusable="False" Margin="4,0,14,0" Foreground="{DynamicResource AmosLabelFg}"/>
                </StackPanel>
            </WrapPanel>
            <!-- The song's settings, always on a row of their own -->
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Title" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Name="TitleBox" Width="140" Margin="0,0,12,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Speed" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <NumericUpDown Name="SpeedBox" Minimum="1" Maximum="31" Increment="1" FormatString="0" Width="110" Margin="0,0,8,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tempo" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <NumericUpDown Name="TempoBox" Minimum="32" Maximum="255" Increment="1" FormatString="0" Width="110" Margin="0,0,8,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Octave" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <NumericUpDown Name="OctaveBox" Minimum="0" Maximum="8" Increment="1" FormatString="0" Width="110" Margin="0,0,8,0" ToolTip.Tip="F1 / F2"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Step" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <NumericUpDown Name="StepBox" Minimum="0" Maximum="16" Increment="1" FormatString="0" Width="110" Margin="0,0,8,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Channels" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <NumericUpDown Name="ChannelsBox" Minimum="4" Maximum="32" Increment="1" FormatString="0" Width="110"
                                   ToolTip.Tip="How many channels the song uses, 4 – 32. Sound effects (TRACK SFX) use channels 5 – 8 above the song's, or borrow channel 8."/>
                </StackPanel>
            </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Statusrad -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource AmosPanelBg}" BorderBrush="{DynamicResource AmosPanelBorder}" BorderThickness="0,2,0,0" Padding="8,4">
            <TextBlock Name="StatusText" Classes="amos-label" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Left: order list and patterns -->
        <Border DockPanel.Dock="Left" Width="200" Background="{DynamicResource AmosPanelBg}" BorderBrush="{DynamicResource AmosPanelBorder}" BorderThickness="0,0,2,0">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <TextBlock Text="ORDER" Classes="amos-title" HorizontalAlignment="Center"/>
                    <UniformGrid Columns="2">
                        <Button Margin="2,0" Content="INS" Classes="amos-button" Click="OrderInsert_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Insert a position after the selected one"/>
                        <Button Margin="2,0" Content="DEL" Classes="amos-button" Click="OrderDelete_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <Button Margin="2,0" Content="PAT -" Classes="amos-button" Click="OrderPatternDown_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Margin="2,0" Content="PAT +" Classes="amos-button" Click="OrderPatternUp_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Past the last pattern a new empty pattern is made"/>
                    </UniformGrid>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
                    <TextBlock Text="PATTERN" Classes="amos-title" HorizontalAlignment="Center"/>
                    <Button Content="CLONE PATTERN" Classes="amos-button" Click="ClonePattern_OnClick" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Copy the pattern to a new one and use it here"/>
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="Rows" Classes="amos-label" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <NumericUpDown Grid.Column="1" Name="RowsBox" Minimum="1" Maximum="256" Increment="16" FormatString="0"/>
                    </Grid>
                </StackPanel>
                <ListBox Name="OrderList" Classes="tracker-list" Margin="0,8,0,0" Background="{DynamicResource AmosInputBg}" FontFamily="Menlo, Consolas, Courier New, monospace"/>
            </DockPanel>
        </Border>

        <!-- Right: the instruments; their settings are on the instrument page -->
        <Border DockPanel.Dock="Right" Width="250" Background="{DynamicResource AmosPanelBg}" BorderBrush="{DynamicResource AmosPanelBorder}" BorderThickness="2,0,0,0">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                    <TextBlock Text="INSTRUMENTS" Classes="amos-title" HorizontalAlignment="Center"/>
                    <UniformGrid Columns="3">
                        <Button Margin="2,0" Content="ADD" Classes="amos-button" Click="InstAdd_OnClick" Focusable="False" Padding="2,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Margin="2,0" Content="CLONE" Classes="amos-button" Click="InstClone_OnClick" Focusable="False" Padding="2,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Margin="2,0" Content="DEL" Classes="amos-button" Click="InstDelete_OnClick" Focusable="False" Padding="2,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </UniformGrid>
                    <Button Margin="2,0" Content="LIBRARY..." Classes="amos-button" Click="InstLibrary_OnClick" Focusable="False" Padding="2,4"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Ready-made instruments by category: bass, lead, pad, drums ..."/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="EDIT INSTRUMENT" Classes="amos-button" Click="InstrumentTab_OnClick" Focusable="False"
                        Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="F4, or double-click an instrument"/>
                <ListBox Name="InstrumentList" Classes="tracker-list" Background="{DynamicResource AmosInputBg}" FontFamily="Menlo, Consolas, Courier New, monospace"/>
            </DockPanel>
        </Border>

        <!-- Middle: the pattern page and the instrument page -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource AmosPanelBg}" BorderBrush="{DynamicResource AmosPanelBorder}" BorderThickness="0,0,0,2" Padding="6,4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton Name="PatternTab" Content="PATTERN" Classes="amos-button" IsChecked="True" Focusable="False" Click="PatternTab_OnClick" ToolTip.Tip="F3"/>
                    <ToggleButton Name="InstrumentTab" Content="INSTRUMENT" Classes="amos-button" Focusable="False" Click="InstrumentTab_OnClick" ToolTip.Tip="F4"/>
                </StackPanel>
            </Border>
            <Grid>
                <!-- The pattern, with an oscilloscope and level meter per channel above it -->
                <DockPanel Name="PatternPage">
                    <local:ChannelScopes Name="Scopes" DockPanel.Dock="Top"/>
                    <local:PatternView Name="Pattern"/>
                </DockPanel>
                <!-- The scroll bar is kept outside the settings, so that it never covers them -->
                <ScrollViewer Name="InstrumentPage" IsVisible="False" AllowAutoHide="False"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Border Name="InstrumentKeys" Focusable="True" Background="Transparent" Padding="12,12,20,12">
                        <StackPanel Name="InstrumentPanel" Spacing="10"/>
                    </Border>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
