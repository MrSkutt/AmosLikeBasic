<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AmosLikeBasic"
        x:Class="AmosLikeBasic.SpritesheetConfigDialog"
        Title="Spritesheet"
        Width="820" Height="560" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,230">

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Name="TitleText" Text="Split the picture into frames"
                   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AmosTitleFg}" Margin="0,0,0,12"/>

        <!-- The whole sheet with the frame grid on top -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource AmosCanvasBg}"
                BorderBrush="{DynamicResource AmosPanelBorder}" BorderThickness="1" Margin="0,0,12,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <local:SheetPreview Name="Preview" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="Frame width:" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="1" Name="FrameWidthUpDown" Minimum="1" Maximum="4096" Value="32" Increment="1" FormatString="0"/>
            </Grid>
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="Frame height:" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="1" Name="FrameHeightUpDown" Minimum="1" Maximum="4096" Value="32" Increment="1" FormatString="0"/>
            </Grid>
            <Grid ColumnDefinitions="100,*">
                <TextBlock Text="Frames:" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="1" Name="FrameCountUpDown" Minimum="1" Maximum="4096" Value="1" Increment="1" FormatString="0"/>
            </Grid>
            <Button Content="Guess from the picture" Click="GuessButton_OnClick" HorizontalAlignment="Stretch"/>
            <TextBlock Name="InfoText" Foreground="{DynamicResource AmosLabelFg}" TextWrapping="Wrap"/>

            <TextBlock Text="Animation" Foreground="{DynamicResource AmosLabelFg}" Margin="0,8,0,0"/>
            <Border Background="{DynamicResource AmosCanvasBg}" BorderBrush="{DynamicResource AmosPanelBorder}"
                    BorderThickness="1" Height="170">
                <Image Name="AnimImage" Stretch="Uniform" Margin="6" RenderOptions.BitmapInterpolationMode="None"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Click="OkButton_OnClick" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Click="CancelButton_OnClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
