<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="AmosLikeBasic.AboutWindow"
        Title="About AMOS IDE"
        Width="420" Height="280"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent">

    <!-- Outer Border mimicking AMOS Window feel -->
    <Border BorderBrush="#7FB2FF" BorderThickness="2" CornerRadius="0">
        <Grid RowDefinitions="Auto, *">
            
            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#FFD400" Height="24" Padding="5,0">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="System Message" 
                               FontFamily="Topaz a600a1200a400, Courier New" 
                               FontWeight="Bold" 
                               Foreground="Black" 
                               VerticalAlignment="Center"/>
                    <!-- Close X implementation (visual only here, button below closes) -->
                    <Border Grid.Column="1" Background="Black" Width="14" Height="14" Margin="0,2">
                        <TextBlock Text="" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area with Copper-like gradient -->
            <Border Grid.Row="1" Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.0" Color="#00134D"/>
                        <GradientStop Offset="0.8" Color="#00134D"/>
                        <GradientStop Offset="1.0" Color="#06206F"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                    
                    <!-- Logo / Title -->
                    <TextBlock Text="AMOS PRO IDE" 
                               FontFamily="Topaz a600a1200a400, Courier New" 
                               FontSize="28" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="0" OffsetX="3" OffsetY="3"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <Separator Background="#7FB2FF" Height="2" Width="200"/>

                    <TextBlock Text="C# / Avalonia Reimplementation" 
                               FontFamily="Topaz a600a1200a400, Courier New" 
                               FontSize="14" 
                               Foreground="#FFD400" 
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="v1.0 (2026)" 
                               FontFamily="Topaz a600a1200a400, Courier New" 
                               FontSize="12" 
                               Foreground="#7FB2FF" 
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Keep the Amiga spirit alive!" 
                               FontFamily="Topaz a600a1200a400, Courier New" 
                               FontSize="12" 
                               FontStyle="Italic"
                               Foreground="#AAAAAA" 
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>

                    <!-- OK Button -->
                    <Button x:Name="OkButton" 
                            Content="OK" 
                            Width="80" 
                            HorizontalContentAlignment="Center"
                            Background="#00CC00" 
                            Foreground="White" 
                            FontFamily="Topaz a600a1200a400, Courier New"
                            FontWeight="Bold"
                            BorderBrush="White"
                            BorderThickness="1"
                            Margin="0,15,0,0"
                            HorizontalAlignment="Center"
                            Click="OkButton_OnClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>