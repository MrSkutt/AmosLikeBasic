{"Version":1,"ProgramText":"FOR I = 20 TO 1 STEP -1\n    FOR X = 0 TO 31\n      FOR Y = 0 TO 23\n        BOX X*20\u002B20-I, Y*20\u002B20-I, X*20\u002BI, Y*20\u002BI\n      NEXT Y\n    NEXT X\n    WAIT 20\nNEXT I\n","ScreenWidth":640,"ScreenHeight":480,"Sprites":[],"MapWidth":1,"MapHeight":1,"MapData":[-1]}