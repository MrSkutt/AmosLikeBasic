<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AmosLikeBasic.SpriteEditorWindow"
        Width="1000" Height="700"
        Title="Sprite Editor">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">

    <!-- Top controls -->
    <Border Background="#06206F" BorderBrush="#7FB2FF" BorderThickness="2" Padding="10">
      <Grid ColumnDefinitions="Auto,110,Auto,110,Auto,110,Auto,*"
            RowDefinitions="Auto,Auto,Auto">

        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#7FB2FF" FontWeight="Bold" Text="Sprite ID" VerticalAlignment="Center"/>
        <NumericUpDown Grid.Row="0" Grid.Column="1" Name="SpriteIdUpDown"
                       Minimum="0" Maximum="256" Value="0"
                       Increment="1"
                       Foreground="White" Background="#00134D"
                       ValueChanged="SpriteIdUpDown_OnValueChanged"/>

        <TextBlock Grid.Row="0" Grid.Column="2" Foreground="#7FB2FF" FontWeight="Bold" Text="Width" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <NumericUpDown Grid.Row="0" Grid.Column="3" Name="WidthUpDown"
                       Minimum="1" Maximum="256" Value="32"
                       Increment="1"
                       Foreground="White" Background="#00134D"
                       ValueChanged="SizeUpDown_OnValueChanged"/>

        <TextBlock Grid.Row="0" Grid.Column="4" Foreground="#7FB2FF" FontWeight="Bold" Text="Height" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <NumericUpDown Grid.Row="0" Grid.Column="5" Name="HeightUpDown"
                       Minimum="1" Maximum="256" Value="32"
                       Increment="1"
                       Foreground="White" Background="#00134D"
                       ValueChanged="SizeUpDown_OnValueChanged"/>

        <Button Grid.Row="0" Grid.Column="6" Name="CreateButton"
                Content="Create/Resize"
                Margin="16,0,0,0"
                Click="CreateButton_OnClick"/>

        <!-- Palette Row -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <TextBlock Foreground="#7FB2FF" FontWeight="Bold" Text="Palette:" VerticalAlignment="Center"/>

          <Button Width="28" Height="28" Background="White" Click="PaletteWhite_OnClick"/>
          <Button Width="28" Height="28" Background="Black" Click="PaletteBlack_OnClick"/>
          <Button Width="28" Height="28" Background="Red" Click="PaletteRed_OnClick"/>
          <Button Width="28" Height="28" Background="Lime" Click="PaletteGreen_OnClick"/>
          <Button Width="28" Height="28" Background="Blue" Click="PaletteBlue_OnClick"/>
          <Button Width="28" Height="28" Background="Yellow" Click="PaletteYellow_OnClick"/>
          <Button Width="28" Height="28" Background="Cyan" Click="PaletteCyan_OnClick"/>
          <Button Width="28" Height="28" Background="Magenta" Click="PaletteTransparent_OnClick"/>

          <!-- Current Color Indicator - med mer separation -->
          <Border Width="40" Height="28" BorderBrush="White" BorderThickness="3" Margin="16,0,0,0" Background="Black">
            <Rectangle Name="CurrentColorRect" Fill="White"/>
          </Border>
          
          <Button Content="Pick Color..." Click="PickColorButton_OnClick" Margin="8,0,0,0"/>


          <Button Content="Clear" Click="ClearButton_OnClick" Margin="16,0,0,0"/>

          <TextBlock Margin="20,0,0,0" Foreground="#7FB2FF" FontWeight="Bold" Text="Zoom:" VerticalAlignment="Center"/>
          <Slider Name="ZoomSlider"
                  Minimum="4" Maximum="30" Value="12"
                  Width="140"
                  ValueChanged="ZoomSlider_OnValueChanged"/>
          <TextBlock Name="ZoomText" Foreground="White" VerticalAlignment="Center" Text="12x"/>
        </StackPanel>

        <!-- File Operations Row -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Content="Load Sprite..." Click="LoadButton_OnClick"/>
          <Button Content="Load Spritesheet..." Click="LoadSpritesheetButton_OnClick"/>
          <Button Content="Save" Click="SaveButton_OnClick"/>
          <Button Content="Save As..." Click="SaveAsButton_OnClick"/>
          <TextBlock Name="FileNameText" Foreground="#7FB2FF" VerticalAlignment="Center" Text="(no file loaded)" Margin="12,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Canvas -->
    <Border Grid.Row="1" Margin="0,12,0,0" Background="#00134D" BorderBrush="#7FB2FF" BorderThickness="2" Padding="10">
      <ScrollViewer HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
        <Border Background="Black" BorderBrush="#7FB2FF" BorderThickness="2" Padding="10"
                HorizontalAlignment="Left" VerticalAlignment="Top">
          <Image Name="SpriteImage"
                 Stretch="Fill"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 RenderOptions.BitmapInterpolationMode="None"
                 Focusable="True"
                 Cursor="Cross"
                 PointerPressed="SpriteImage_OnPointerPressed"
                 PointerMoved="SpriteImage_OnPointerMoved"
                 PointerReleased="SpriteImage_OnPointerReleased"/>
        </Border>
      </ScrollViewer>
    </Border>

    <!-- Frame Navigation -->
    <Border Grid.Row="2" Background="#06206F" BorderBrush="#7FB2FF" BorderThickness="2" Padding="10" Margin="0,12,0,0"
            Name="FrameNavigationPanel" IsVisible="False">
      <Grid ColumnDefinitions="Auto,*,Auto">
        
        <!-- Navigation Buttons -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Button Width="70" Click="PrevFrameButton_OnClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="◀" VerticalAlignment="Center"/>
              <TextBlock Text="Prev" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Name="FrameInfoText" Foreground="#7FB2FF" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
          <Button Width="70" Click="NextFrameButton_OnClick">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Next" VerticalAlignment="Center"/>
              <TextBlock Text="▶" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Frame Thumbnails -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="20,0">
          <StackPanel Name="FrameThumbnailsPanel" Orientation="Horizontal" Spacing="4"/>
        </ScrollViewer>

        <!-- Add/Delete Frame -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="+ Add Frame" Click="AddFrameButton_OnClick"/>
          <Button Content="− Delete Frame" Click="DeleteFrameButton_OnClick"/>
        </StackPanel>

      </Grid>
    </Border>

  </Grid>
</Window>