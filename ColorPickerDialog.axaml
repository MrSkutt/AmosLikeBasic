<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AmosLikeBasic.ColorPickerDialog"
        Title="Color"
        Width="440" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0F0F13">

  <Window.Styles>
    <Style Selector="Slider">
      <Setter Property="Height" Value="4"/>
    </Style>
    <Style Selector="Slider /template/ Track">
      <Setter Property="Height" Value="4"/>
    </Style>
    <Style Selector="Slider /template/ Thumb">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="BorderBrush" Value="#2A2A38"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7C6FFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#1E1E2A"/>
      <Setter Property="Foreground" Value="#8888AA"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2A2A3A"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- Lägg till HorizontalContentAlignment och VerticalContentAlignment i styles -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7C6FFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#1E1E2A"/>
      <Setter Property="Foreground" Value="#8888AA"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2A2A3A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

  </Window.Styles>

  <Grid Margin="24" RowDefinitions="Auto,16,Auto,20,Auto,20,Auto">

    <!-- Header -->
    <TextBlock Grid.Row="0"
               Text="Pick a color"
               Foreground="White"
               FontSize="18"
               FontWeight="Bold"
               LetterSpacing="0.5"/>

    <!-- Color Wheel + Brightness Canvas -->
    <Grid Grid.Row="2" ColumnDefinitions="*,16,Auto">

      <!-- Color Wheel (Canvas drawn via code-behind) -->
      <Border Grid.Column="0"
              Width="200" Height="200"
              CornerRadius="100"
              ClipToBounds="True"
              HorizontalAlignment="Center">
        <Canvas Name="ColorWheelCanvas"
                Width="200" Height="200"
                PointerPressed="ColorWheel_OnPointerPressed"
                PointerMoved="ColorWheel_OnPointerMoved">
          <!-- Wheel indicator dot -->
          <Ellipse Name="WheelIndicator"
                   Width="16" Height="16"
                   Fill="Transparent"
                   Stroke="White"
                   StrokeThickness="2"
                   Canvas.Left="92" Canvas.Top="92"/>
        </Canvas>
      </Border>

      <!-- Brightness + Alpha strip -->
      <StackPanel Grid.Column="2" Width="24" Spacing="8" VerticalAlignment="Center">
        <!-- Brightness bar -->
        <Border CornerRadius="12" Width="24" Height="160" ClipToBounds="True">
          <Canvas Name="BrightnessCanvas"
                  Width="24" Height="160"
                  PointerPressed="Brightness_OnPointerPressed"
                  PointerMoved="Brightness_OnPointerMoved">
            <Ellipse Name="BrightnessIndicator"
                     Width="20" Height="20"
                     Fill="Transparent"
                     Stroke="White"
                     StrokeThickness="2"
                     Canvas.Left="2" Canvas.Top="2"/>
          </Canvas>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Preview + Hex -->
    <Grid Grid.Row="4" ColumnDefinitions="*,12,Auto">

      <!-- Color preview swatch -->
      <Border Grid.Column="0" Height="52" CornerRadius="12" ClipToBounds="True">
        <Grid ColumnDefinitions="*,*">
          <!-- Checkerboard for transparency -->
          <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#1E1E2A"/>
          <!-- Color fill -->
          <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Name="PreviewRect"/>
        </Grid>
      </Border>

      <!-- Hex input -->
      <Border Grid.Column="2" Background="#1A1A28" CornerRadius="10"
              BorderBrush="#2A2A40" BorderThickness="1"
              Padding="12,0" Height="52" Width="140">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="HEX" Foreground="#555577" FontSize="10" FontWeight="Bold" LetterSpacing="1.5"/>
          <TextBox Name="HexInput"
                   Background="Transparent"
                   Foreground="White"
                   FontSize="15"
                   FontWeight="SemiBold"
                   BorderThickness="0"
                   Padding="0"
                   CaretBrush="White"
                   TextChanged="HexInput_OnTextChanged"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- RGB Sliders -->
    <StackPanel Grid.Row="6" Spacing="14">

      <!-- R -->
      <Grid ColumnDefinitions="14,*,38">
        <TextBlock Grid.Column="0" Text="R" Foreground="#FF6B8A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Margin="8,0" Height="4" CornerRadius="2" ClipToBounds="True">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
              <GradientStop Offset="0" Color="#1A0010"/>
              <GradientStop Offset="1" Color="#FF6B8A"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Slider Grid.Column="1" Margin="8,0" Name="RedSlider" Minimum="0" Maximum="255" ValueChanged="ColorSlider_OnValueChanged"
                Background="Transparent"/>
        <TextBlock Grid.Column="2" Name="RedText" Foreground="#FF6B8A" FontSize="12" FontWeight="Bold"
                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>

      <!-- G -->
      <Grid ColumnDefinitions="14,*,38">
        <TextBlock Grid.Column="0" Text="G" Foreground="#51CF88" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Margin="8,0" Height="4" CornerRadius="2" ClipToBounds="True">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
              <GradientStop Offset="0" Color="#001A08"/>
              <GradientStop Offset="1" Color="#51CF88"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Slider Grid.Column="1" Margin="8,0" Name="GreenSlider" Minimum="0" Maximum="255" ValueChanged="ColorSlider_OnValueChanged"
                Background="Transparent"/>
        <TextBlock Grid.Column="2" Name="GreenText" Foreground="#51CF88" FontSize="12" FontWeight="Bold"
                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>

      <!-- B -->
      <Grid ColumnDefinitions="14,*,38">
        <TextBlock Grid.Column="0" Text="B" Foreground="#4DABF7" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Margin="8,0" Height="4" CornerRadius="2" ClipToBounds="True">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
              <GradientStop Offset="0" Color="#00081A"/>
              <GradientStop Offset="1" Color="#4DABF7"/>
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Slider Grid.Column="1" Margin="8,0" Name="BlueSlider" Minimum="0" Maximum="255" ValueChanged="ColorSlider_OnValueChanged"
                Background="Transparent"/>
        <TextBlock Grid.Column="2" Name="BlueText" Foreground="#4DABF7" FontSize="12" FontWeight="Bold"
                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>

      <!-- Buttons -->
      <Grid ColumnDefinitions="*,10,*" Margin="0,6,0,0">
        <Button Grid.Column="0" Content="OK" Height="44"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="primary"
                Click="OkButton_OnClick" IsDefault="True"/>
        <Button Grid.Column="2" Content="Cancel" Height="44"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Classes="secondary"
                Click="CancelButton_OnClick"/>
      </Grid>


    </StackPanel>

  </Grid>
</Window>
