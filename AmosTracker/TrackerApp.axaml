<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmosLikeBasic.TrackerApp"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <!-- The same look as in AMOS Like Basic -->
        <StyleInclude Source="avares://AmosLikeBasic.Tracker/AmosStyles.axaml" />
    </Application.Styles>
</Application>
