{
  "Version": 2,
  "ProgramText": "; ════════════════════════════════════════════════════════════════\n;  TRACKER DEMO\n;\n;  Plays a song made for the tracker: Sound/Tracker/forest_song.amostrk\n;  It is the same Forest Song as in Forest Hop, written as patterns\n;  with instruments and effects, like in ProTracker. Open the file\n;  with the TRACKER button, or in a text editor, to see how it is built.\n;\n;  Space: stop or play    1 - 4: jump to a pattern\n; ════════════════════════════════════════════════════════════════\nTRACK LOAD \"Sound/Tracker/forest_song.amostrk\"\nTRACK PLAY\n\nPAPER 0 : CLS\nLOCATE 2,2 : PRINT \"FOREST SONG\"\nLOCATE 2,4 : PRINT \"SPACE: STOP OR PLAY\"\nLOCATE 2,5 : PRINT \"1 - 4: JUMP TO A PATTERN\"\n\nLoop:\n  K$ = INKEY$\n  IF K$ = \" \" THEN\n    IF TRACKPLAYING() = 1 THEN\n      TRACK STOP\n    ELSE\n      TRACK PLAY\n    ENDIF\n  ENDIF\n  IF K$ >= \"1\" AND K$ <= \"4\" THEN TRACK PLAY VAL(K$) - 1\n  LOCATE 2,8\n  IF TRACKPLAYING() = 1 THEN\n    PRINT \"PATTERN \" & TRACKPOS() & \"   ROW \" & RIGHT$(\"0\" & TRACKROW(), 2) & \"   \"\n  ELSE\n    PRINT \"STOPPED                    \"\n  ENDIF\n  ; A bar that goes round once per bar of music\n  INKG \"#203060\" : BAR 16, 160, 527, 175\n  INKG \"#7FD07F\" : BAR 16, 160, 16 + (TRACKROW() MOD 16) * 32 + 31, 175\n  WAIT VBL\nGOTO Loop\n"
}