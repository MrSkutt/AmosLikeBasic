{"Version":2,"ProgramText":"SCREEN 640,480\nINK Green\n; Make a string from ASCII codes\nLET A$ = CHR$(65) + CHR$(66) + CHR$(67)\nPRINT A$ ; Skriver ut \"ABC\"\n\n; Get the ASCII value of a character\nLET V = ASC(\"A\")\nPRINT V ; Skriver ut 65\n\n; Or mix with variables\nLET K$ = \"X\"\nPRINT \"ASCII for \" + K$ + \" is \" + STR$(ASC(K$))\n\n;Arrays\nDIM A(10)\nFOR I=1 TO 5\n   A(I) = I*2\n   PRINT A(I)\nNEXT\n\n;HEX\nFOR K=0 TO 15\n\tPRINT HEX(K)\nNEXT\n\nFOR I=0 TO 640\n  INKG RED\n  PLOT I, SIN(I)*240+240\n  INKG BLUE\n  PLOT I, SIN(I+180)*240+240\n  WAIT 10\nNEXT\n\n\n","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}