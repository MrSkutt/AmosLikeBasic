{"Version":2,"ProgramText":"ON ERROR RESUME NEXT\n\nA=1/0\nPRINT A\n\n\nON ERROR GOTO ErrorHandler\n\nX=10\nFOR I = 10 TO 0 STEP -1\n  PRINT X/I\nNEXT I\n\nPRINT \"DONE\"\n\nEND\n\nErrorHandler:\n    PRINT \"Oops! An error happened on line \" & ERL\n    PRINT \"Felet var: \" & ERR$\n    END","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}