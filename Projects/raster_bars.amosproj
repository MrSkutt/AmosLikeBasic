{"Version":2,"ProgramText":"; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  RASTER BARS\n;\n;  Layer 0: blue and white bars that swing up and down behind a\n;  frame of flowers.\n;  Layer 1: the text, with a rainbow that only shows on the red\n;  colour in the font. That is RASTER COLOUR, the classic Amiga and\n;  Atari ST trick of changing one palette colour on every line.\n;\n;  Music: a fast C64-style demo tune. Open the file with the\n;  TRACKER button to see it.\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nTRACK LOAD \u0022Sound/Tracker/raster_dream.amostrk\u0022\nTRACK PLAY\n\n; \u2500\u2500 Layer 0: the swinging bars and the flowers \u2500\u2500\nRASTER CLEAR\nFOR I = 2 TO 9\n  RASTER I, 0, 0, 40, \u0022Blue, White, Blue\u0022\nNEXT I\nLOAD \u0022Graphics/Layer/FlowerMaskWhite.png\u0022\n\n; \u2500\u2500 Layer 1: the text, with a rainbow on its red colour \u2500\u2500\nSCREEN SELECT 1\nFONT LOAD 0, \u0022Graphics/font.png\u0022, 32, 25\nFONT MAP 0, \u0022ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00A3$%.\u2019[]\u201D,-\u0022\nFONT ZOOM 0,200,200\nFONT PRINT #1, 0, 0, 134, \u0022HELLO AMOS\u0022\nFONT PRINT #1, 0, 64, 300, \u0022RASTERS!\u0022\nRASTER #0,1, 0, 0, 480, \u0022White, Blue\u0022\nRASTER #1,1, 0, 0, 480, \u0022Red, Orange, Yellow, Green, Blue, Indigo, Violet, Red\u0022\nRASTER WRAP 1, TRUE\n; Only where layer 1 is red, the colour in the middle of the letters\nRASTER COLOUR 1, \u0022Red\u0022\n\nY = 0\nY2 = 0\nMainLoop:\n  INC Y\n  IF Y=360 THEN Y=0\n  FOR I = 2 TO 9\n    RASTER #0, MOVE I, SIN(Y\u002BI*10)*220\u002B220\n  NEXT I\n  ; The rainbow rolls upwards through the letters\n  RASTER #1, MOVE 1, Y2\n  DEC Y2\n  IF Y2=-480 THEN Y2=0\n  WAIT VBL\nGOTO MainLoop\n"}