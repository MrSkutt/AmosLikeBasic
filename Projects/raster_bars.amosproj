{"Version":2,"ProgramText":"; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  RASTER BARS\n;\n;  Layer 0: blue and white bars that swing up and down over a\n;  white-to-blue background, behind a frame of flowers.\n;  Layer 1: the text, with a rainbow that only shows on the red\n;  colour in the font. That is RASTER COLOUR, the classic Amiga and\n;  Atari ST trick of changing one palette colour on every line.\n;\n;  Music: a fast C64-style demo tune. Open the file with the\n;  TRACKER button to see it.\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nTRACK LOAD \"Sound/Tracker/raster_dream.amostrk\"\nTRACK PLAY\n\n; \u2500\u2500 Layer 0: a white-to-blue background, the swinging bars and the flowers \u2500\u2500\n; The band made last lies on top, so the background comes first\nRASTER CLEAR\nRASTER 1, 0, 0, 480, \"White, Blue\"\nFOR I = 2 TO 9\n  RASTER I, 0, 0, 40, \"Blue, White, Blue\"\nNEXT I\nLOAD \"Graphics/Layer/FlowerMaskWhite.png\"\n\n; \u2500\u2500 Layer 1: the text, with a rainbow on its red colour \u2500\u2500\nSCREEN SELECT 1\nFONT LOAD 0, \"Graphics/font.png\", 32, 25\nFONT MAP 0, \"ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00a3$%.\u2019[]\u201d,-\"\nFONT ZOOM 0,200,200\nFONT PRINT #1, 0, 0, 134, \"HELLO AMOS\"\nFONT PRINT #1, 0, 64, 300, \"RASTERS!\"\nRASTER #1,1, 0, 0, 480, \"Red, Orange, Yellow, Green, Blue, Indigo, Violet, Red\"\nRASTER WRAP 1, TRUE\n; Only where layer 1 is red, the colour in the middle of the letters\nRASTER COLOUR 1, \"Red\"\n\nY = 0\nY2 = 0\nMainLoop:\n  INC Y\n  IF Y=360 THEN Y=0\n  FOR I = 2 TO 9\n    RASTER #0, MOVE I, SIN(Y+I*10)*220+220\n  NEXT I\n  ; The rainbow rolls upwards through the letters\n  RASTER #1, MOVE 1, Y2\n  DEC Y2\n  IF Y2=-480 THEN Y2=0\n  WAIT VBL\nGOTO MainLoop\n"}