{"Version":2,"ProgramText":"INKG WHITE\nSCREEN SELECT 1\nFONT SET 70,100,\"Courier New\"\nPRINTG AT 1,7,\"PHALANX\"\nFONT SET 30,50,\"Courier New\"\nPRINTG AT 2,8,\"RULES\"\n\nSCREEN SELECT 0\n\n;PARTICLE 2,40\n\nSAM LOOP \"Sound/rain.mp3\"\nPRINT \"The rain is pouring down...\"\n\nDOUBLE BUFFER\n\nx=0\nLoop:\n  x=x+1\n  IF x=300 THEN\n    GOTO slut\n  ENDIF\n  WAIT VBL\nGOTO Loop\n\nslut:\nSAM STOP \"Sound/rain.mp3\"\nPRINT \"Regnet slutade.\"","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}