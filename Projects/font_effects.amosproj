{"Version":2,"ProgramText":"SCREEN 640, 480\nRASTER SPACE 0,1\n;TILE LOAD \"Graphics/Tiles/tileset.png\", 32, 32\n;TILE MAP 100, 15\n;MAP LOAD \"Graphics/test2.amosmap\"\n;TILE DRAW 0, 0\n\nMUSIC PLAY \"Sound/Tracker/MODs/music.mod\"\n\nFONT LOAD 0, \"Graphics/font.png\", 32, 25\nFONT MAP 0, \"ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00a3$%.\u2019[]\u201d,-\"\nFONT LOAD 1, \"Graphics/font2.png\", 32, 34\nFONT MAP 1, \"ABCDEFGHIJKLMNOPQRSTUVWXYZ@\u00a3$\u221e0123456789!'()?-/.,\"\nFONT LOAD 2, \"Graphics/font2.png\", 32, 34\nFONT MAP 2, \"ABCDEFGHIJKLMNOPQRSTUVWXYZ@\u00a3$\u221e0123456789!'()?-/.,\"\nFONT LOAD 3, \"Graphics/font2.png\", 32, 34\nFONT MAP 3, \"ABCDEFGHIJKLMNOPQRSTUVWXYZ@\u00a3$\u221e0123456789!'()?-/.,\"\nSCREEN SELECT 1\n;LOAD \"Graphics/Layer/Gooniex.png\"\n\nSCREEN SELECT 2\nPARTICLE 1,20\n\nSCREEN SELECT 0\n\nV = 360;Y = 0;X = 0;VY = 0;TY=640\n\nMainLoop:\n  FONT CLEAR ; Important: clear old texts before drawing new ones\n  RASTER 1,0,0,480,\"Black, Red\"  \n  \n; Update the angle\n  V = V - 2\n  IF V = 0 THEN V = 360\n  \n  Y = Y +2\n  IF Y = 640 THEN Y = 0\n\n  VY = VY + 2\n  IF VY = 360 THEN VY = 0\n\n  X = X + 1\n  IF X = 480 THEN X = 0\n  \n  TY=TY-1\n  IF TY=0 THEN TY=640\n  ; Set the look\n  FONT ROTATE 0, V\n  FONT ZOOM 0, 200, 200 ; Dubbel storlek\n\n  \n  ; Print in the middle of the screen\n  FONT PRINT #3,0, 0, 134, \"HELLO AMOS\"\n  FONT EFFECT ADD 0, WAVE 30.0,0.05\n\n;  FONT ZOOM 2, VY*2, VY*2 ; Dubbel storlek\n;  FONT PRINT 2, 30, 180, \"HELLO AMOS\"\n;  FONT ZOOM 3, 400-VY*2, 400-VY*2 ; Dubbel storlek\n;  FONT PRINT 3, 30, 180, \"HELLO AMOS\"\n\n  FONT ZOOM 1, 200,COS(VY)*300\n  FONT PRINT #3,1, 100, 300, \"PHALANX\"\n  FONT ZOOM 1, COS(VY-180)*300,SIN(VY-180)*300\n  FONT PRINT #3,1, 160, 380, \"RULES\"\n\n  ;SCROLL 0, TY,0\n  ;SCROLL 1, Y, X\n\n  WAIT VBL\nGOTO MainLoop"}