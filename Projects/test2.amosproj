{"Version":1,"ProgramText":"maxRooms = 2\nRESTORE Room\nFOR i = 1 TO maxRooms\n    READ roomDesc$(i), north(i), south(i), east(i), west(i)\nNEXT i\n\nmaxObj = 2\nRESTORE Object\nFOR i = 1 TO maxObj\n    READ objName$(i), objStartRoom(i)\nNEXT i\n\nRoom:\nDATA \"Hall\",2,0,0,0\nDATA \"Kitchen\",0,1,0,0\n\nObject:\nDATA \"Nyckel\",2\nDATA \"Lampa\",1","ScreenWidth":640,"ScreenHeight":480,"Sprites":[],"MapWidth":0,"MapHeight":0,"MapData":[]}