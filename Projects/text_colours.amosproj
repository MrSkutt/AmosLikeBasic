{"Version":2,"ProgramText":"INKG Red\nPRINTG \"HI!\"\n\nINKG \"Green\"\nPRINTG \"HI!\"\n\nINKG #0000FF\nPRINTG \"HI!\"\n\nINKG \"#FF00FF\"\nPRINTG \"HI!\"\n\nINKG 5\nPRINTG \"HI!\"\n\nI=14\nINKG I\nPRINTG \"HI!\"\n\nA$=\"#FF4444\"\nINKG A$\nPRINTG \"HI!\"\n\n\nFOR I = 1 TO 15\n    a$=\"ABCDEFGHIJKLMNO\"\n    INKG I\n    b$ = MID$(a$,i,1)\n\tPRINTG b$,\nNEXT I\n\nPRINTG\n\nFOR I = 1 TO 15\n    a$=\"ABCDEFGHIJKLMNO\"\n    col = \"#FF\" & Hex(I) & Hex(I) & Hex(I) & Hex(I)\n    INKG col\n    b$ = MID$(a$,i,1)\n\tPRINTG b$,\nNEXT I\n\n\nINKG GREEN\nFOR I=0 TO 639\n  PLOT I,SIN(I)*240+240\nNEXT I","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}