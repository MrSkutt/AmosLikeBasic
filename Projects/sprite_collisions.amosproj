{"Version":2,"ProgramText":"SCREEN 640, 480\n\nIMAGE LOAD 1, \"Graphics/hero.png\"     \n\nSPRITE ON 1\nSPRITE IMAGE 1,1,0\nSPRITE POS 1,300,240\n\nFOR I = 2 TO 10\n  SPRITE ON I\n  SPRITE IMAGE I,1,0\n  SPRITE GROUP I, \"enemy\"\n  SPRITE POS I,RND(640),RND(480)\nNEXT I\n\n\nrem SPRITE GROUP 6, \"bullet\"\n\nspriteX = 320\nspriteY = 240\n\nMainLoop:\n  CLSG\n\n  hit = HITGROUP(1,\"enemy\")\n  IF hit > 0 THEN\n    currhit = hit\n    PRINTG \"COLLISION!\"\n    PLAY EXPLOSION\n    SPRITE OFF hit\n    SPRITE UNGROUP hit, \"enemy\"\n  ENDIF\n \n  ; Analog movement with the left stick\n  spriteX = spriteX + (JOYAXIS(1, \"LeftX\") / 20)\n  spriteY = spriteY + (JOYAXIS(1, \"LeftY\") / 20)\n\n  ; Keep inside the screen\n  spriteX = MAX(0, MIN(640, spriteX))\n  spriteY = MAX(0, MIN(480, spriteY))\n\n  ; Right trigger = fire\n  IF JOYAXIS(1, \"RT\") > 50 THEN GOSUB Shoot\n\n  PRINTG AT 0,8,INT(spriteX) & \" - \" & INT(spriteY) & \" - \" & currhit\n  PRINTG AT 0,9,INT(JOYAXIS(1, \"LeftX\")) & \" - \" & INT(JOYAXIS(1, \"LeftY\"))\n  SPRITE POS 1, spriteX, spriteY \n\n  WAIT VBL\nGOTO MainLoop\n\n"}