{"Version":2,"ProgramText":"SAM PLAY \u0022Sound/ANCOOL1.mp3\u0022\nRASTER 1,0,0,480,\u0022Blue, White\u0022\nRASTER WRAP 1,1\nSPRITE LOAD 1, \u0022Graphics/Logos/Scoopex_1.png\nSPRITE POS 1, 182,180\n;SPRITE HANDLE 1,276/2,200/2\nSPRITE ON 1\n\nFONT LOAD 0, \u0022Graphics/font.png\u0022, 32, 25\nFONT MAP 0, \u0022ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00A3$%.\u2019[]\u201D,-\u0022\nFONT ZOOM 0,200,200\nFONT PRINT 0,0,0,\u0022HEJ\u0022\nFONT EFFECT ADD 0, WAVE, 20, 0.02, 100.0 ,0.014\n\nSPRITE EFFECT ADD 1, BLUR 1.0\n\n\nSPRITE EFFECT ADD 1, WAVE, 365, 0.0024, 360, 0.0015\ntext$=\u0022           HEJ!! DETTA AR EN KORT SCROLLTEXT           #\u0022\nX=0 : X2=0 : TX=0 : Y=180\nY2=99 : Y3=0\n\nWhile 1\n  FONT CLEAR\n  amp = 200 \u002B SIN(TIMER * 0.05) * 200\n  ;SPRITE EFFECT UPDATE 1, 1, AMPLITUDEY, amp\n  ;SPRITE EFFECT UPDATE 1, 1, PHASEY, ph\n  SPRITE ZOOM 1,Y2\n  SPRITE ROTATE 1,SIN(Y3)*10\n  INC Y3\n  IF Y2\u003C100 THEN Y2=Y2\u002B0.1\n  ph = ph \u002B 0.02\n\n ; FONT PRINT 0,X,SIN(y)*200\u002B430,MID$(text$, tx,11)\n  FONT PRINT 0,X,330,text$\n  FONT EFFECT ADD 0, WAVE, 0, 0.0, 100.0 ,0.014\n  FONT EFFECT UPDATE 0, 0, TIME, TIMER\n  TIMER = TIMER \u002B 0.4\n\n  X=X-4 : X2=X2-4\n  IF MID$(text$, tx\u002B11,1) = \u0022#\u0022 THEN TX=0 : X=0 : X2=0\n  IF X2=-64 THEN X2=0 : INC TX\n\n  ;Y=Y\u002B2 \n  IF Y=360 THEN Y=180\n  \n  WAIT VBL\n  TIMER = TIMER \u002B 0.2\nWend"}