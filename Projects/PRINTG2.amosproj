{"Version":2,"ProgramText":"INKG WHITE\nPAPERG BLUE\nCLSG\nPRINTG \u0022READY.\u0022\nX = 0\n\nREPEAT\n  X = X \u002B 1\n  PRINTG \u0022LINE \u0022 \u002B X\n  WAIT 100\nUNTIL X = 20\n\nX=0\nY=240\nFOR I = 0 TO 639\n   X2=I\n   Y2=SIN(I)*240\u002B240\n   LINE X,Y,X2,Y2\n   X=X2\n   Y=Y2\n   WAIT 10\nNEXT I\n\n","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}