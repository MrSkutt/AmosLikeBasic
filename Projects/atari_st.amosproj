{"Version":2,"ProgramText":"; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  ATARI ST\n;\n;  In the style of the Atari ST demos of 1988 \u2013 1990: raster bars in\n;  the ST\u0027s own colours (eight steps each of red, green and blue, 512\n;  colours in all), a starfield in three planes, a wobbling chrome\n;  title and a big sine scroller, to music from the ST\u0027s sound chip,\n;  the YM2149: a YM file, the chip\u0027s registers fifty times a second\n;  (Sound/Tracker/reminder.ym, made in the tracker).\n;\n;  Layer 0: the raster bars          Layer 1: the stars\n;  Layer 2: the title                Layer 3: the scroller\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nSCREEN 640,480\nMUSIC PLAY \u0022Sound/Tracker/reminder.ym\u0022\n\n; \u2500\u2500 Layer 0: black, and three raster bars in the ST\u0027s colour steps \u2500\u2500\nSCREEN SELECT 0\nRASTER CLEAR\nRASTER 1, 0, 0, 480, \u0022#000000, #000000\u0022\nRASTER 2, 0, 0, 45, \u0022#000000, #400000, #A00000, #E00000, #A00000, #400000, #000000\u0022\nRASTER 3, 0, 0, 45, \u0022#000000, #004000, #00A000, #00E000, #00A000, #004000, #000000\u0022\nRASTER 4, 0, 0, 45, \u0022#000000, #000040, #0000A0, #0000E0, #0000A0, #000040, #000000\u0022\n\n; \u2500\u2500 Layer 1: 60 stars in three planes, the far ones slow and dim \u2500\u2500\nNS = 60\nDIM SX(NS), SY(NS), SP(NS)\nFOR I = 1 TO NS\n  SX(I) = RND(640) : SY(I) = RND(480) : SP(I) = 1 + I MOD 3\nNEXT I\n\n; \u2500\u2500 Layer 2: the title, the chrome font with a rainbow on its blue \u2500\u2500\nSCREEN SELECT 2\nFONT LOAD 0, \u0022Graphics/Fonts/32/015_32.png\u0022, 32, 32\nFONT MAP 0, \u0022 !~#$%&\u0027()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\u0022\nFONT ZOOM 0, 250\nRASTER 1, 0, 0, 480, \u0022Red, Yellow, Lime, Cyan, Blue, Magenta, Red\u0022\nRASTER WRAP 1, TRUE\nRASTER COLOUR 2, \u0022#000044\u0022\nTITLE$ = \u0022ATARI ST\u0022\n\n; \u2500\u2500 Layer 3: the big scroller, font.png at 300 %, copper on its red \u2500\u2500\nSCREEN SELECT 3\nFONT LOAD 1, \u0022Graphics/font.png\u0022, 32, 25\nFONT MAP 1, \u0022ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00A3$%.\u2019[]\u201D,-\u0022\nFONT ZOOM 1, 300\nRASTER 1, 0, 300, 140, \u0022#404000, #808000, #C0C000, #E0E000, #E0E000, #C0C000, #808000, #404000\u0022\nRASTER COLOUR 3, \u0022Red\u0022\nTXT$ = \u0022              HELLO ATARI ST FANS!   RASTERS IN THE 512 COLOURS OF THE ST,\u0022\nTXT$ = TXT$ & \u0022 STARS IN THREE PLANES AND MUSIC FROM THE YM2149, A YM FILE MADE IN THE TRACKER.\u0022\nTXT$ = TXT$ & \u0022   GREETINGS TO ALL WHO EVER OPENED THE BORDERS...   \u0022\nCW = 96\nSC = 0 : T = 0\n\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nLoop:\n  T = T + 1\n\n  ; The raster bars swing through each other\n  FOR I = 2 TO 4\n    RASTER #0, MOVE I, 218 + SIN(T * 1.8 + I * 120) * 200\n  NEXT I\n\n  ; The stars fly left, each plane at its speed and brightness\n  SCREEN SELECT 1\n  CLSG\n  FOR P = 1 TO 3\n    IF P = 1 THEN INKG \u0022#404060\u0022\n    IF P = 2 THEN INKG \u0022#9090B0\u0022\n    IF P = 3 THEN INKG \u0022#FFFFFF\u0022\n    FOR I = 1 TO NS\n      IF SP(I) = P THEN\n        SX(I) = SX(I) - P * 2\n        IF SX(I) < 0 THEN SX(I) = SX(I) + 640 : SY(I) = RND(480)\n        BAR SX(I), SY(I), SX(I) + P, SY(I) + P - 1\n      ENDIF\n    NEXT I\n  NEXT P\n\n  ; The title: each letter on a wave of its own\n  FONT CLEAR\n  FOR K = 0 TO LEN(TITLE$) - 1\n    FONT PRINT #2, 0, 40 + K * 72, 40 + SIN(T * 4 + K * 35) * 26, MID$(TITLE$, K + 1, 1)\n  NEXT K\n  RASTER #2, MOVE 1, -((T * 3) MOD 480)\n\n  ; The scroller, each letter at a height from SIN of where it is\n  SC = SC + 5\n  IF SC >= LEN(TXT$) * CW THEN SC = 0\n  C = INT(SC / CW)\n  FOR K = 0 TO 7\n    X = K * CW - (SC MOD CW)\n    FONT PRINT #3, 1, X, 330 + SIN(X * 0.5 + T * 3) * 30, MID$(TXT$ & TXT$, C + 1 + K, 1)\n  NEXT K\n\n  SCREEN SELECT 0\n  WAIT VBL\nGOTO Loop\n","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}