{"Version":2,"ProgramText":"SAM PLAY \"Sound/ANCOOL1.mp3\"\nRASTER SPACE 0,2\nFONT LOAD 0, \"Graphics/font.png\", 32, 25\nFONT MAP 0, \"ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00a3$%.\u2019[]\u201d,-\"\nFONT ZOOM 0,200,200\n;FONT ROTATE 0,90\nFONT PRINT #1,0,0,200,\"HELLO THERE\"\n\nFONT EFFECT ADD 0, BLUR 1.0\n\nTIMER = 0\n\nY=0\nZ=0\nLoop:\n  FONT CLEAR\n  FONT ROTATE 0,Y\n  FONT ZOOM 0,Z\n  IF Z<150 THEN INC Z\n  FONT PRINT #1,0,0,200,\"HELLO THERE\"\n  FONT EFFECT ADD 0, WAVE, 100, 0.02, 100.0 ,0.014\n\n  INC Y\n  IF Y=360 THEN Y=0\n  \n  FONT EFFECT UPDATE 0, 1, TIME, TIMER    \n  TIMER = TIMER + 0.5\n  WAIT VBL\nGoto Loop\n  "}