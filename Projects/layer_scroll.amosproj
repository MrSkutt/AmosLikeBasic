{"Version":2,"ProgramText":"LOAD #1,\u0022Graphics/berg.png\u0022\nLOAD #2,\u0022Graphics/Layer/Beast.png\u0022\nLOAD #3,\u0022Graphics/Layer/Background.png\u0022\nLOAD #4,\u0022Graphics/Layer/C64Monitor.png\u0022\nLOAD #5,\u0022Graphics/Layer/FlowerMaskWhite.png\u0022\n \nx=0\nLoop:\n  SCROLL 1,x,0\n  SCROLL 2,x*2,0\n  SCROLL 3,x*3,0\n  inc x\n  WAIT VBL\nGOTO Loop","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}