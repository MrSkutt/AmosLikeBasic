{"Version":2,"ProgramText":"LOAD #1,\u0022Graphics/berg.png\u0022\nLOAD #2,\u0022Graphics/Layer/Beast.png\u0022\nLOAD #3,\u0022Graphics/Layer/Background.png\u0022\nLOAD #4,\u0022Graphics/Layer/C64Monitor.png\u0022\n \n\nSCREEN FADE 4,255,120\nWhile Layerfading(4) = 1\n  WAIT VBL\nWEND\n\nSCREEN FADE 3, 255, 120\nWhile Layerfading(3) = 1\n  WAIT VBL\nWEND\n\nSCREEN FADE 2, 255, 120\nWhile Layerfading(2) = 1\n  WAIT VBL\nWEND\n\nSCREEN FADE 1, 255, 120\nWhile Layerfading(1) = 1\n  WAIT VBL\nWEND\n\nx=0\nLoop:\n  SCROLL 0,x,0\n  SCROLL 1,x*2,0\n  SCROLL 2,x*3,0\n  inc x\n  WAIT VBL\nGOTO Loop","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}