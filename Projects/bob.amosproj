{"Version":2,"ProgramText":"RASTER 1,0,0,480,\u0022Blue, White\u0022\nIMAGE LOAD 1,\u0022Graphics/Bobs/Solarsystem/04.png\u0022\nSPRITE 1,40,0,1\nSPRITE HANDLE 1,32,32\nSPRITE ZOOM 1,200,200\n\nSPRITE ON 1\n\nLOAD \u0022Graphics/berg.png\u0022\nI=0\nV=0\nX=0\nLoop:\n   SCROLL 0,I,0\n   SPRITE MOVE 1,2,0 \n   SPRITE ROTATE 1,V\n   INC V\n   DEC X\n   DEC I\n   IF SPRITE#X(1) \u003E 640 THEN \n      SPRITE MOVE 1,-640,0\n   ENDIF\n  WAIT VBL\nGOTO Loop","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}