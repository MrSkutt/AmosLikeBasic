{"Version":2,"ProgramText":"; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  THE OLD HOUSE - a text adventure\n;\n;  Find grandmother\u0027s lost music box and bring it back to the hall.\n;\n;  Type commands such as: LOOK, NORTH (or N), TAKE LAMP, EXAMINE BOOK,\n;  OPEN DOOR, UNLOCK DOOR, TURN ON LAMP, READ LETTER, INVENTORY (or I),\n;  SCORE, PICTURE (pictures of the rooms on or off), HELP and QUIT.\n;\n;  Everything in the world is DATA at the end of the program: the\n;  rooms, the doors between them and the things in them. To add a room,\n;  add a line under Rooms, give it exits, and raise NR by one.\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n\nNR = 7        ; rooms\nNI = 6        ; things\nND = 1        ; doors\n\nDIM RNAME$(NR) : DIM RDESC$(NR) : DIM RDARK(NR) : DIM RPIC$(NR) : DIM EX(NR, 6)\nDIM INAME$(NI) : DIM IALIAS$(NI) : DIM IDESC$(NI) : DIM IROOM(NI) : DIM IMOVE(NI) : DIM IPTS(NI)\nDIM DNAME$(ND) : DIM DRA(ND) : DIM DDA(ND) : DIM DRB(ND) : DIM DDB(ND) : DIM DSTATE(ND) : DIM DKEY(ND)\nDIM DIRN$(6) = [\u0022\u0022, \u0022north\u0022, \u0022south\u0022, \u0022east\u0022, \u0022west\u0022, \u0022up\u0022, \u0022down\u0022]\n\nCONST CARRIED = -1     ; IROOM of a thing the player carries\nCONST NOWHERE = 0      ; IROOM of a thing that is not in the game (yet)\nCONST LAMP = 1 : CONST KEY = 2 : CONST BOOK = 3 : CONST LETTER = 4 : CONST MUSICBOX = 5\nCONST WINBONUS = 20\n\nLoadWorld\nPAPER 6 : INK 1 : CLS\nPRINT \u0022THE OLD HOUSE\u0022\nPRINT \u0022=============\u0022\nPRINT \u0022Grandmother has lost her music box somewhere in the old house.\u0022\nPRINT \u0022Find it and bring it back to the hall. Type HELP if you get stuck.\u0022\nR = 1 : SCORE = 0 : MOVES = 0 : LAMPON = 0 : DONE = 0\nPICON = 0     ; 1 = show a picture of each room in the game window\nMAXSCORE = WINBONUS\nFOR I = 1 TO NI\n  MAXSCORE = MAXSCORE \u002B IPTS(I)\nNEXT I\nDescribe\n\nDO\n  PRINT\n  INPUT \u0022\u003E \u0022, CMD$\n  CMD$ = LOWER$(TRIM$(CMD$))\n  IF CMD$ \u003C\u003E \u0022\u0022 THEN\n    MOVES = MOVES \u002B 1\n    DoCommand CMD$\n    CheckWin\n  ENDIF\nLOOP UNTIL DONE = 1\nPRINT\nPRINT \u0022You scored \u0022 \u0026 SCORE \u0026 \u0022 of \u0022 \u0026 MAXSCORE \u0026 \u0022 points in \u0022 \u0026 MOVES \u0026 \u0022 moves.\u0022\nEND\n\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  Reading the world\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nPROC LoadWorld\n  LOCAL I, D\n  RESTORE Rooms\n  FOR I = 1 TO NR\n    READ RNAME$(I), RDESC$(I), RDARK(I), RPIC$(I)\n    FOR D = 1 TO 6\n      READ EX(I, D)\n    NEXT D\n  NEXT I\n  RESTORE Things\n  FOR I = 1 TO NI\n    READ INAME$(I), IALIAS$(I), IDESC$(I), IROOM(I), IMOVE(I), IPTS(I)\n  NEXT I\n  RESTORE Doors\n  FOR I = 1 TO ND\n    READ DNAME$(I), DRA(I), DDA(I), DRB(I), DDB(I), DSTATE(I), DKEY(I)\n  NEXT I\nEND PROC\n\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  Commands\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nPROC DoCommand(C$)\n  LOCAL VERB$, NOUN$, D, SP\n  SP = INSTR(C$, \u0022 \u0022)\n  IF SP \u003E 0 THEN\n    VERB$ = LEFT$(C$, SP - 1)\n    NOUN$ = TRIM$(MID$(C$, SP \u002B 1))\n  ELSE\n    VERB$ = C$\n  ENDIF\n  ; \u0022the\u0022 and \u0022a\u0022 carry no meaning here\n  IF LEFT$(NOUN$, 4) = \u0022the \u0022 THEN NOUN$ = MID$(NOUN$, 5)\n  IF LEFT$(NOUN$, 2) = \u0022a \u0022 THEN NOUN$ = MID$(NOUN$, 3)\n\n  ; A direction alone (N, NORTH ...) or GO NORTH\n  D = DirOf(VERB$)\n  IF D \u003E 0 THEN\n    Walk D\n    EXIT PROC\n  ENDIF\n\n  SELECT CASE VERB$\n  CASE \u0022go\u0022, \u0022walk\u0022\n    D = DirOf(NOUN$)\n    IF D = 0 THEN\n      PRINT \u0022Go where?\u0022\n    ELSE\n      Walk D\n    ENDIF\n  CASE \u0022look\u0022, \u0022l\u0022\n    Describe\n  CASE \u0022examine\u0022, \u0022x\u0022, \u0022inspect\u0022\n    Examine NOUN$\n  CASE \u0022take\u0022, \u0022get\u0022, \u0022pick\u0022\n    IF LEFT$(NOUN$, 3) = \u0022up \u0022 THEN NOUN$ = MID$(NOUN$, 4)\n    Take NOUN$\n  CASE \u0022drop\u0022, \u0022put\u0022\n    Drop NOUN$\n  CASE \u0022inventory\u0022, \u0022i\u0022, \u0022inv\u0022\n    Inventory\n  CASE \u0022open\u0022\n    DoorAction NOUN$, 0\n  CASE \u0022close\u0022, \u0022shut\u0022\n    DoorAction NOUN$, 1\n  CASE \u0022unlock\u0022\n    DoorAction NOUN$, 2\n  CASE \u0022turn\u0022, \u0022switch\u0022\n    IF LEFT$(NOUN$, 3) = \u0022on \u0022 OR NOUN$ = \u0022on\u0022 THEN\n      Light 1\n    ELSE IF LEFT$(NOUN$, 4) = \u0022off \u0022 OR NOUN$ = \u0022off\u0022 THEN\n      Light 0\n    ELSE\n      PRINT \u0022Turn it on or off?\u0022\n    ENDIF\n  CASE \u0022light\u0022\n    Light 1\n  CASE \u0022read\u0022\n    ReadThing NOUN$\n  CASE \u0022score\u0022\n    PRINT \u0022You have \u0022 \u0026 SCORE \u0026 \u0022 of \u0022 \u0026 MAXSCORE \u0026 \u0022 points after \u0022 \u0026 MOVES \u0026 \u0022 moves.\u0022\n  CASE \u0022picture\u0022, \u0022pictures\u0022, \u0022show\u0022\n    PICON = 1 - PICON\n    IF PICON = 1 THEN PRINT \u0022Pictures on.\u0022 ELSE PRINT \u0022Pictures off.\u0022\n    UpdateScreen\n  CASE \u0022help\u0022, \u0022h\u0022, \u0022?\u0022\n    PRINT \u0022Try LOOK, the directions N S E W U D, TAKE, DROP, EXAMINE, OPEN,\u0022\n    PRINT \u0022UNLOCK, TURN ON LAMP, READ, INVENTORY, SCORE, PICTURE and QUIT.\u0022\n    PRINT \u0022PICTURE turns pictures of the rooms on and off.\u0022\n  CASE \u0022quit\u0022, \u0022q\u0022\n    DONE = 1\n  CASE ELSE\n    PRINT \u0022I don\u0027t know how to \u0022 \u0026 VERB$ \u0026 \u0022.\u0022\n  END SELECT\nEND PROC\n\n; \u2500\u2500 Moving \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nPROC Walk(D)\n  LOCAL T, DR\n  T = EX(R, D)\n  IF T = 0 THEN\n    PRINT \u0022You can\u0027t go \u0022 \u0026 DIRN$(D) \u0026 \u0022 from here.\u0022\n    EXIT PROC\n  ENDIF\n  DR = DoorAt(R, D)\n  IF DR \u003E 0 THEN\n    IF DSTATE(DR) = 2 THEN\n      PRINT \u0022The \u0022 \u0026 DNAME$(DR) \u0026 \u0022 is locked.\u0022\n      EXIT PROC\n    ENDIF\n    IF DSTATE(DR) = 1 THEN\n      PRINT \u0022The \u0022 \u0026 DNAME$(DR) \u0026 \u0022 is closed.\u0022\n      EXIT PROC\n    ENDIF\n  ENDIF\n  R = T\n  IF D = 5 THEN SAM PLAY \u0022Sound/stairs.mp3\u0022\n  Describe\nEND PROC\n\nPROC Describe\n  LOCAL I, N, LINES$\n  UpdateScreen\n  PRINT\n  PRINT \u0022[ \u0022 \u0026 UPPER$(RNAME$(R)) \u0026 \u0022 ]\u0022\n  IF CanSee() = 0 THEN\n    PRINT \u0022It is pitch dark. You can\u0027t see a thing.\u0022\n    EXIT PROC\n  ENDIF\n  ; Long descriptions are split into lines at |\n  LINES$ = SPLIT$(RDESC$(R), \u0022|\u0022)\n  FOR I = 0 TO DIM(LINES$) - 1\n    PRINT LINES$(I)\n  NEXT I\n  FOR I = 1 TO NI\n    IF IROOM(I) = R AND IMOVE(I) = 1 THEN PRINT \u0022There is \u0022 \u0026 INAME$(I) \u0026 \u0022 here.\u0022\n  NEXT I\n  N = 0\n  FOR I = 1 TO 6\n    IF EX(R, I) \u003E 0 THEN N = N \u002B 1\n  NEXT I\n  IF N \u003E 0 THEN\n    LINES$ = \u0022Exits:\u0022\n    FOR I = 1 TO 6\n      IF EX(R, I) \u003E 0 THEN LINES$ = LINES$ \u0026 \u0022 \u0022 \u0026 DIRN$(I)\n    NEXT I\n    PRINT LINES$\n  ENDIF\nEND PROC\n\n; \u2500\u2500 Things \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nPROC Take(N$)\n  LOCAL T\n  IF CanSee() = 0 THEN\n    PRINT \u0022It is too dark to find anything.\u0022\n    EXIT PROC\n  ENDIF\n  T = ThingHere(N$)\n  IF T = 0 THEN\n    IF ThingCarried(N$) \u003E 0 THEN\n      PRINT \u0022You already have it.\u0022\n    ELSE\n      PRINT \u0022You see no \u0022 \u0026 N$ \u0026 \u0022 here.\u0022\n    ENDIF\n    EXIT PROC\n  ENDIF\n  IF IMOVE(T) = 0 THEN\n    PRINT \u0022You can\u0027t take that.\u0022\n    EXIT PROC\n  ENDIF\n  IROOM(T) = CARRIED\n  PRINT \u0022Taken: \u0022 \u0026 INAME$(T) \u0026 \u0022.\u0022\n  SCORE = SCORE \u002B IPTS(T)\n  IPTS(T) = 0            ; the points only count the first time\nEND PROC\n\nPROC Drop(N$)\n  LOCAL T\n  T = ThingCarried(N$)\n  IF T = 0 THEN\n    PRINT \u0022You don\u0027t have that.\u0022\n    EXIT PROC\n  ENDIF\n  IROOM(T) = R\n  PRINT \u0022Dropped: \u0022 \u0026 INAME$(T) \u0026 \u0022.\u0022\nEND PROC\n\nPROC Inventory\n  LOCAL I, N\n  N = 0\n  PRINT \u0022You are carrying:\u0022\n  FOR I = 1 TO NI\n    IF IROOM(I) = CARRIED THEN\n      PRINT \u0022  \u0022 \u0026 INAME$(I)\n      N = N \u002B 1\n    ENDIF\n  NEXT I\n  IF N = 0 THEN PRINT \u0022  nothing at all.\u0022\nEND PROC\n\nPROC Examine(N$)\n  LOCAL T\n  IF N$ = \u0022\u0022 THEN\n    PRINT \u0022Examine what?\u0022\n    EXIT PROC\n  ENDIF\n  T = ThingCarried(N$)\n  IF T = 0 THEN\n    IF CanSee() = 0 THEN\n      PRINT \u0022It is too dark to see anything.\u0022\n      EXIT PROC\n    ENDIF\n    T = ThingHere(N$)\n  ENDIF\n  IF T = 0 THEN\n    PRINT \u0022You see no \u0022 \u0026 N$ \u0026 \u0022 here.\u0022\n    EXIT PROC\n  ENDIF\n  PRINT IDESC$(T)\n  ; The key is hidden in the book\n  IF T = BOOK AND IROOM(KEY) = NOWHERE THEN\n    PRINT \u0022As you open it, a brass key falls out onto the floor!\u0022\n    IROOM(KEY) = R\n  ENDIF\n  IF T = LAMP THEN\n    IF LAMPON = 1 THEN PRINT \u0022It is on.\u0022 ELSE PRINT \u0022It is off.\u0022\n  ENDIF\nEND PROC\n\nPROC ReadThing(N$)\n  LOCAL T\n  T = ThingCarried(N$)\n  IF T = 0 THEN T = ThingHere(N$)\n  IF T = LETTER THEN\n    PRINT \u0022The letter says:\u0022\n    PRINT \u0022  \u0027My dear, I put my music box where it is cold and dark,\u0022\n    PRINT \u0022   below the kitchen, so that nobody would find it. Love, Grandma\u0027\u0022\n  ELSE IF T = BOOK THEN\n    PRINT \u0022The pages are full of drawings of the house. Try examining it.\u0022\n  ELSE\n    PRINT \u0022There is nothing to read.\u0022\n  ENDIF\nEND PROC\n\nPROC Light(STATE)\n  IF ThingCarried(\u0022lamp\u0022) = 0 THEN\n    PRINT \u0022You have nothing to light.\u0022\n    EXIT PROC\n  ENDIF\n  IF LAMPON = STATE THEN\n    IF STATE = 1 THEN PRINT \u0022The flashlight is already on.\u0022 ELSE PRINT \u0022The flashlight is already off.\u0022\n    EXIT PROC\n  ENDIF\n  LAMPON = STATE\n  IF STATE = 1 THEN\n    PRINT \u0022The flashlight clicks on.\u0022\n    IF RDARK(R) = 1 THEN Describe\n  ELSE\n    PRINT \u0022The flashlight clicks off.\u0022\n    IF RDARK(R) = 1 THEN PRINT \u0022Everything goes black.\u0022\n    UpdateScreen\n  ENDIF\nEND PROC\n\n; \u2500\u2500 Doors \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n; WHAT: 0 open, 1 close, 2 unlock. N$ is \u0022door\u0022 or a direction.\nPROC DoorAction(N$, WHAT)\n  LOCAL DR, D\n  D = DirOf(N$)\n  IF D \u003E 0 THEN\n    DR = DoorAt(R, D)\n  ELSE\n    DR = DoorIn(R)\n  ENDIF\n  IF DR = 0 THEN\n    PRINT \u0022There is no door there.\u0022\n    EXIT PROC\n  ENDIF\n  IF WHAT = 2 THEN\n    IF DSTATE(DR) \u003C 2 THEN\n      PRINT \u0022It isn\u0027t locked.\u0022\n    ELSE IF IROOM(DKEY(DR)) \u003C\u003E CARRIED THEN\n      PRINT \u0022You need a key for that.\u0022\n    ELSE\n      DSTATE(DR) = 1\n      PRINT \u0022Click! The \u0022 \u0026 DNAME$(DR) \u0026 \u0022 is unlocked.\u0022\n    ENDIF\n  ELSE IF WHAT = 0 THEN\n    IF DSTATE(DR) = 2 THEN\n      PRINT \u0022It is locked.\u0022\n    ELSE IF DSTATE(DR) = 0 THEN\n      PRINT \u0022It is already open.\u0022\n    ELSE\n      DSTATE(DR) = 0\n      PRINT \u0022The \u0022 \u0026 DNAME$(DR) \u0026 \u0022 creaks open.\u0022\n    ENDIF\n  ELSE\n    IF DSTATE(DR) \u003E 0 THEN\n      PRINT \u0022It is already closed.\u0022\n    ELSE\n      DSTATE(DR) = 1\n      PRINT \u0022You close the \u0022 \u0026 DNAME$(DR) \u0026 \u0022.\u0022\n    ENDIF\n  ENDIF\nEND PROC\n\n; \u2500\u2500 The rest \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n; The game window follows the room: black when it is too dark to see, otherwise blue, with the\n; room\u0027s picture if pictures are on and the room has one\nPROC UpdateScreen\n  IF CanSee() = 0 THEN\n    PAPER 0\n    CLSG\n  ELSE\n    PAPER 6\n    IF PICON = 1 AND RPIC$(R) \u003C\u003E \u0022\u0022 THEN\n      LOAD RPIC$(R)\n    ELSE\n      CLSG\n    ENDIF\n  ENDIF\nEND PROC\n\nPROC CheckWin\n  IF R = 1 AND IROOM(MUSICBOX) = CARRIED AND DONE = 0 THEN\n    PRINT\n    PRINT \u0022You wind up the music box. A little silver dancer turns to a\u0022\n    PRINT \u0022tune you have not heard since you were small. Grandma smiles.\u0022\n    PRINT \u0022*** YOU HAVE WON ***\u0022\n    SCORE = SCORE \u002B WINBONUS\n    DONE = 1\n  ENDIF\nEND PROC\n\nFUNCTION CanSee()\n  IF RDARK(R) = 0 THEN RETURN 1\n  IF LAMPON = 1 AND (IROOM(LAMP) = CARRIED OR IROOM(LAMP) = R) THEN RETURN 1\n  RETURN 0\nEND FUNCTION\n\n; 1 - 6 for a direction word or its first letter, else 0\n; (The functions let their loops run to the end and RETURN afterwards: a RETURN inside a FOR\n;  would leave the loop unfinished.)\nFUNCTION DirOf(W$)\n  RES = 0\n  FOR K = 1 TO 6\n    IF RES = 0 AND (W$ = DIRN$(K) OR W$ = LEFT$(DIRN$(K), 1)) THEN RES = K\n  NEXT K\n  RETURN RES\nEND FUNCTION\n\n; The thing in this room (or carried) that a word names: its name or one of its aliases\nFUNCTION ThingHere(W$)\n  RES = 0\n  FOR K = 1 TO NI\n    IF RES = 0 AND IROOM(K) = R AND INSTR(\u0022,\u0022 \u0026 IALIAS$(K) \u0026 \u0022,\u0022, \u0022,\u0022 \u0026 W$ \u0026 \u0022,\u0022) \u003E 0 THEN RES = K\n  NEXT K\n  RETURN RES\nEND FUNCTION\n\nFUNCTION ThingCarried(W$)\n  RES = 0\n  FOR K = 1 TO NI\n    IF RES = 0 AND IROOM(K) = CARRIED AND INSTR(\u0022,\u0022 \u0026 IALIAS$(K) \u0026 \u0022,\u0022, \u0022,\u0022 \u0026 W$ \u0026 \u0022,\u0022) \u003E 0 THEN RES = K\n  NEXT K\n  RETURN RES\nEND FUNCTION\n\n; The door through exit D of room RM, or 0\nFUNCTION DoorAt(RM, D)\n  RES = 0\n  FOR K = 1 TO ND\n    IF RES = 0 AND ((DRA(K) = RM AND DDA(K) = D) OR (DRB(K) = RM AND DDB(K) = D)) THEN RES = K\n  NEXT K\n  RETURN RES\nEND FUNCTION\n\n; The first door of room RM, or 0\nFUNCTION DoorIn(RM)\n  RES = 0\n  FOR K = 1 TO ND\n    IF RES = 0 AND (DRA(K) = RM OR DRB(K) = RM) THEN RES = K\n  NEXT K\n  RETURN RES\nEND FUNCTION\n\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  The world\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n; Room: name, description (| starts a new line), dark (1 = needs light), picture,\n;       then the room numbers through the exits north, south, east, west, up, down (0 = none)\nRooms:\nDATA \u0022Hall\u0022, \u0022You stand in the hall of an old house. Dust dances in the light|from the front door. A heavy door leads north, the garden is|to the west and a creaking staircase goes up.\u0022, 0, \u0022Graphics/1.png\u0022, 2, 0, 0, 6, 3, 0\nDATA \u0022Kitchen\u0022, \u0022An old kitchen that smells of bread long gone. A narrow|stair goes down into the dark.\u0022, 0, \u0022Graphics/2.png\u0022, 0, 1, 0, 0, 0, 5\nDATA \u0022Landing\u0022, \u0022The upstairs landing. A door to the east stands ajar, and a|ladder leads up to the attic.\u0022, 1, \u0022Graphics/3.png\u0022, 0, 0, 4, 0, 7, 1\nDATA \u0022Library\u0022, \u0022Shelves full of dusty books reach the ceiling.\u0022, 0, \u0022\u0022, 0, 0, 0, 3, 0, 0\nDATA \u0022Cellar\u0022, \u0022A cold cellar. Water drips somewhere in the dark.\u0022, 1, \u0022\u0022, 0, 0, 0, 0, 2, 0\nDATA \u0022Garden\u0022, \u0022An overgrown garden. A rusty bench stands under an apple tree.\u0022, 0, \u0022\u0022, 0, 0, 1, 0, 0, 0\nDATA \u0022Attic\u0022, \u0022A low attic under the roof beams. Old trunks are everywhere.\u0022, 0, \u0022\u0022, 0, 0, 0, 0, 0, 3\n\n; Thing: the name in sentences, the words for it, the description,\n;        the room it starts in (0 = not in the game yet), can be taken (1/0), points\nThings:\nDATA \u0022a flashlight\u0022, \u0022flashlight,lamp,torch,light\u0022, \u0022An old flashlight. It still works.\u0022, 6, 1, 5\nDATA \u0022a brass key\u0022, \u0022key,brass key\u0022, \u0022A heavy brass key.\u0022, 0, 1, 10\nDATA \u0022a thick book\u0022, \u0022book,thick book\u0022, \u0022\u0027Secrets of the Old House\u0027, reads the cover.\u0022, 4, 1, 0\nDATA \u0022a letter\u0022, \u0022letter,note\u0022, \u0022A yellowed letter in grandmother\u0027s handwriting.\u0022, 7, 1, 5\nDATA \u0022a music box\u0022, \u0022music box,box,musicbox\u0022, \u0022A small music box with a silver dancer on the lid.\u0022, 5, 1, 25\nDATA \u0022shelves\u0022, \u0022shelves,shelf,books\u0022, \u0022Hundreds of books. One thick book sticks out.\u0022, 4, 0, 0\n\n; Door: its name, room and exit on one side, room and exit on the other,\n;       state (0 open, 1 closed, 2 locked), the thing that unlocks it\nDoors:\nDATA \u0022heavy door\u0022, 1, 1, 2, 2, 2, 2\n"}