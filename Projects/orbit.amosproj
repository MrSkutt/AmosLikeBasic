{"Version":2,"ProgramText":"; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  ORBIT\n;\n;  A circle scroller: the text goes round a big circle, each letter\n;  turned to face outwards, and changes at the top. A letter that has\n;  gone round once shrinks away there, as the next message\u0027s letter\n;  grows in its place. Inside the circle the Earth turns, and its\n;  planets go round it, now behind it and now in front, in deep space.\n;\n;  Layer 0: space and stars          Layer 1: the Earth, and the\n;  Layer 2: planets in front of it            planets behind it\n;  Layer 3: the circle of text: its rainbow is a raster on the dark\n;           blue of the chrome letters (RASTER COLOUR)\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nSCREEN 640,480\nMUSIC PLAY \u0022Sound/Tracker/XM/Planetarium.XM\u0022\n\n; \u2500\u2500 Layer 0: deep space, a faint nebula and twinkling stars \u2500\u2500\nSCREEN SELECT 0\nRASTER CLEAR\nRASTER SPACE 0, 1\nRASTER 1, 0, 0, 480, \u0022#000004, #07031C, #180830, #07031C, #000004\u0022\nPARTICLE 3, 20\n\n; \u2500\u2500 Layer 1: the Earth, 48 pictures of a turn \u2500\u2500\nSPRITE LOAD 20, \u0022Graphics/Anim/Anim_Earth_W150_H150_B48.png\u0022\nSPRITE HANDLE 20, 75, 75      ; its middle is the point SPRITE POS puts\nSPRITE ZOOM 20, 150, 150\nSPRITE LAYER 20, 1\nSPRITE POS 20, 320, 240\nSPRITE ON 20\n\n; \u2500\u2500 The planets: each on a flat, tilted orbit of its own \u2500\u2500\nNP = 5\nDIM ORX(NP), SPD(NP)\nFOR I = 1 TO NP\n  SPRITE LOAD I, \u0022Graphics/Bobs/Solarsystem/0\u0022 & I & \u0022.png\u0022\n  SPRITE HANDLE I, 32, 32\n  SPRITE ON I\n  ORX(I) = 110 + I * 28\n  SPD(I) = 2.6 - I * 0.35\nNEXT I\n\n; \u2500\u2500 Layer 3: the circle of text \u2500\u2500\nSCREEN SELECT 3\n; A chrome font, its characters in ASCII order from the space, ten in a row (~ stands for \u0022)\nFONT LOAD 0, \u0022Graphics/Fonts/32/015_32.png\u0022, 32, 32\nFONT MAP 0, \u0022 !~#$%&\u0027()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\u0022\nFONT ZOOM 0, 140\n; The rainbow on the dark blue of the letters; their white shine stays\nRASTER 1, 0, 0, 480, \u0022Red, Orange, Yellow, Green, Cyan, Blue, Magenta, Red\u0022\nRASTER WRAP 1, TRUE\nRASTER COLOUR 3, \u0022#000044\u0022\n\n; The messages: 26 characters each, one for each turn of the circle\nNM = 9\nDIM MSG$(NM - 1)\nRESTORE Messages\nFOR I = 0 TO NM - 1\n  READ MSG$(I)\nNEXT I\n\nM = 26            ; letters round the circle\nCW = 46            ; pixels from one letter to the next\nCIRC = M * CW      ; the circle\u0027s length\nR = 190            ; and its radius (CIRC / 2 / PI)\nS = 0 : T = 0\n\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nLoop:\n  T = T + 1\n\n  ; The Earth turns; the planets go round it, bigger and in front when they are near\n  SPRITE FRAME 20, INT(T / 3) MOD 48\n  FOR I = 1 TO NP\n    A = T * SPD(I) + I * 72\n    Z = COS(A)\n    SPRITE POS I, 320 + SIN(A) * ORX(I), 240 + Z * ORX(I) * 0.28 - SIN(A) * ORX(I) * 0.12\n    SPRITE ZOOM I, 55 + (Z + 1) * 30\n    IF Z > 0 THEN\n      SPRITE LAYER I, 2\n    ELSE\n      SPRITE LAYER I, 1\n    ENDIF\n  NEXT I\n\n  ; The text: letter P of all the messages entered the circle at the top when S was P * CW,\n  ; and goes round it the other way from the clock, so that it reads from left to right at\n  ; the top. After a whole turn it is back at the top, where it shrinks away as letter\n  ; P + M, the next message\u0027s, grows in\n  S = S + 2\n  P0 = INT(S / CW)\n  FONT CLEAR\n  FOR K = 0 TO M - 1\n    P = P0 - K\n    IF P >= 0 THEN\n      D = S - P * CW\n      A = -D * 360 / CIRC\n      C$ = MID$(MSG$(INT(P / M) MOD NM), P MOD M + 1, 1)\n      ZM = 140 * MIN(1, MIN(D, CIRC - D) / CW)\n      FONT ZOOM 0, MAX(1, ZM)\n      FONT ROTATE 0, A\n      FONT PRINT #3, 0, 320 + SIN(A) * R - 22, 240 - COS(A) * R - 22, C$\n    ENDIF\n  NEXT K\n  RASTER #3, MOVE 1, -((T * 3) MOD 480)\n\n  WAIT VBL\nGOTO Loop\n\nMessages:\nDATA \u0022    WELCOME TO ORBIT!     \u0022\nDATA \u0022  A TEXT THAT GOES ROUND  \u0022\nDATA \u0022  AND CHANGES AT THE TOP  \u0022\nDATA \u0022 MADE IN AMOS LIKE BASIC  \u0022\nDATA \u0022  FONT, SPRITES, RASTERS  \u0022\nDATA \u0022   ONE LETTER AT A TIME   \u0022\nDATA \u0022  MUSIC: PLANETARIUM.XM   \u0022\nDATA \u0022 GREETINGS TO ALL CODERS! \u0022\nDATA \u0022   SEE YOU IN SPACE...    \u0022\n","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}