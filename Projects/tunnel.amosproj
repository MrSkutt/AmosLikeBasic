{"Version":2,"ProgramText":"SCREEN 640,480\n\nSAM PLAY \u0022Sound/enchant1.mp3\u0022\n\nSPRITE LOAD 1,\u0022Graphics/Anim/Anim_SinTunnel_W500_H480_B15.png\u0022\nSPRITE POS 1,0,0\nSPRITE ZOOM 1,200,200\nSPRITE ON 1\n\nFONT LOAD 0, \u0022Graphics/font.png\u0022, 32, 25\nFONT MAP 0, \u0022ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00A3$%.\u2019[]\u201D,-\u0022\nFONT ZOOM 0,200,200\nPARTICLE 3,100\n\nDOUBLE BUFFER\nY=0\nF=0\nVX=0\nVY=45\nWhile 1\n  \n  FONT ZOOM 0, 200, 200 ; Dubbel storlek\n\n  ; Skriv ut mitt p\u00E5 sk\u00E4rmen\n  FONT PRINT  0, 0, 134, \u0022HELLO AMOS\u0022\n  \n  SPRITE POS 1,SIN(VX)*110,SIN(VY)*100\n  INC VY\n  VX = VX \u002B 1.5\n  IF VX\u003E359 THEN VX=0\n  IF VY\u003E359 THEN VY = 0\n  \n  SPRITE FRAME 1,F\n  INC F\n  IF F\u003E15 THEN F=0\n  \n  PARTICLE 1,40\n  RASTER 1,0,0,480,\u0022Red,Orange, Yellow, Green, Blue, Indigo, Violet, Red\u0022\n  RASTER WRAP 1,TRUE\n  \n  Y=Y-1\n  IF Y=-560 THEN Y=0\n  \n  WAIT VBL\nWEND","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}