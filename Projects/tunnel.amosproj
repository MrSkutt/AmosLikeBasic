{"Version":2,"ProgramText":"SCREEN 640,480\n\nSAM PLAY \"Sound/enchant1.mp3\"\n\nSPRITE LOAD 1,\"Graphics/Anim/Anim_SinTunnel_B15.png\",500,480,15\nSPRITE POS 1,0,0\nSPRITE ZOOM 1,200,200\nSPRITE ON 1\n\nFONT LOAD 0, \"Graphics/font.png\", 32, 25\nFONT MAP 0, \"ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00a3$%.\u2019[]\u201d,-\"\nFONT ZOOM 0,200,200\nFONT PRINT  #1, 0, 0, 134, \"HELLO AMOS\"\nPARTICLE 3,100\n\nLOAD #2,\"Graphics/berg.png\"\n\nY=0 : F=0 : VX=0 : VY=45\n\nSCREEN SELECT 0\nWhile 1\n  \n  FONT ZOOM 0, 200, 200 ; Dubbel storlek\n\n  SPRITE POS 1,SIN(VX)*110,SIN(VY)*100\n  INC VY\n  VX = VX + 1.5\n  IF VX>359 THEN VX=0\n  IF VY>359 THEN VY = 0\n  \n  SPRITE FRAME 1,F\n  INC F\n  IF F>15 THEN F=0\n  \n  PARTICLE 1,40\n  RASTER 1,0,0,480,\"Red,Orange, Yellow, Green, Blue, Indigo, Violet, Red\"\n  RASTER WRAP 1,TRUE\n  \n  Y=Y-1\n  IF Y=-560 THEN Y=0\n  \n  WAIT VBL\nWEND","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}