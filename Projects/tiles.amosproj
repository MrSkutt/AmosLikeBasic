{"Version":2,"ProgramText":"SCREEN 640, 480\n\nMUSIC PLAY \u0022Sound/mus2.mod\u0022\n\nLOAD #1,\u0022Graphics/berg.png\u0022\n\nSCREEN SELECT 3\nSPRITE LOAD 1, \u0022Graphics/hero.png\u0022\nSPRITE ON 1\nSPRITE LAYER 1,3\n\nSCREEN SELECT 2\n\n; Create MAP 100x15\nTILE MAP 100, 15\nTILE LOAD \u0022Graphics/tileset.png\u0022, 32, 32\nMAP LOAD \u0022Graphics/test.amosmap\u0022\n\n; Rita hela banan EN G\u00C5NG\n;FOR X = 0 TO 99\n;  TILE SET X, 2, 2\n;NEXT X\nTILE DRAW 0, 0\nSCREEN SELECT 0\n\n;PARTICLE 3,20\nRASTER MODE 0,2\nLET MAXSX = 3200\n\nLET SX = 0 : LET SY = 0\nLET Y = 0 : LET VY = 0\nLET ONGROUND = 0\n\nMainLoop:\n  RASTER 1,0,0,480,\u0022Black, #220000, Red\u0022\n  \n  ; 1. Kolla max v\u00E4rden p\u00E5 banan        \n  IF SX \u003C 0 THEN LET SX = 0\n  ;IF SX \u003E MAXSX THEN LET SX = MAXSX  ; Funkar inte l\u00E4ngre av n\u00E5n konstig anledning. \n\n  ; 2. Kolla om vi hoppar upp i block\n  IF TILE(1, 320\u002B16\u002BSX, Y-8) \u003E -1\n    PLAY COIN\n    LET VY=1\n    LET Y = Y \u002B VY\n  ENDIF  \n             \n  ; 3. Kolla mark-kontakt (innan vi flyttar gubben)\n  ; Vi kollar om vi ST\u00C5R p\u00E5 n\u00E5got (VY \u00E4r 0 eller positiv n\u00E4r vi faller)\n  IF TILE(1, 320\u002B16\u002BSX, Y\u002B32\u002B24) \u003E -1\n    LET VY = 0\n    LET Y = INT(Y / 32) * 32\u002B16               \n    LET ONGROUND = 1 \n  ELSE \n    LET ONGROUND = 0\n  ENDIF\n\n  ; 4. Kolla om vi g\u00E5r in i n\u00E5got till h\u00F6ger. \n  IF KEYSTATE(\u0022D\u0022) OR JOYSTATE(1, \u0022Right\u0022) OR JOYAXIS(1, \u0022LeftX\u0022) \u003E 0\n    IF TILE(1, 320\u002B48\u002BSX, Y\u002B32) = -1\n      LET SX = SX \u002B 8\n    ENDIF\n  ENDIF\n\n  ; 5. Kolla om vi g\u00E5r in i n\u00E5got till v\u00E4nster. \n  IF (KEYSTATE(\u0022A\u0022) OR JOYSTATE(1, \u0022Left\u0022)) OR JOYAXIS(1, \u0022LeftX\u0022) \u003C 0\n    IF TILE(1, 320\u002BSX,  Y \u002B32)  = -1\n      LET SX = SX - 8\n    ENDIF\n  ENDIF\n\n  ; 6. Applicera gravitation och flytta (Bara om vi flyger)\n  IF ONGROUND = 0\n    LET VY = VY \u002B 1\n    LET Y = Y \u002B VY\n  ENDIF\n\n  ; 7. Hoppa (Bara om vi st\u00E5r p\u00E5 marken)\n  IF (KEYSTATE(\u0022SPACE\u0022) OR JOYSTATE(1, \u0022A\u0022))\n    IF ONGROUND = 1 \n      PLAY JUMP\n      LET VY = -16\n      LET Y = Y -10\n      LET ONGROUND = 0\n    ENDIF\n  ENDIF\n\n  ; 8. Rita allt\n  SCROLL 0, SX/2, 0\n  SCROLL 1, SX/2, 0\n  SCROLL 2, SX, 0\n\n  SPRITE ROTATE 1,VY*2                                \n  SPRITE POS 1, 320, Y\n  WAIT VBL\nGOTO MainLoop\n\n\n","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}