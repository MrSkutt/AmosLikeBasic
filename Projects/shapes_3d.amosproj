{"Version": 2, "ProgramText": "; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  3D SHAPES\n;\n;  All the shapes OBJECT can make, each with a texture or a colour of\n;  its own, stand in a ring on a chequered floor and turn, while the\n;  camera flies round them and looks at the middle. The light comes\n;  from the top left, so the sides away from it are darker.\n;\n;  Layer 0: the sky (raster) and the floor and shapes (OBJECT)\n;  Layer 1: the title\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nSCREEN 640,480\nMUSIC PLAY \"Sound/Tracker/XM/Horizon.XM\"\n\nSCREEN SELECT 0\nRASTER CLEAR\nRASTER 1, 0, 0, 480, \"#050A30, #2850A0, #A0C8F0\"\n\nOBJECT PLANE 1, 4000, 4000, 10, 10\nOBJECT TEXTURE 1, \"Graphics/Textures/256_003.png\"\nOBJECT POS 1, 0, 100, 0\n\nOBJECT CUBE 2, 130\nOBJECT TEXTURE 2, \"Graphics/Textures/256_002.png\"\nOBJECT SPHERE 3, 75\nOBJECT TEXTURE 3, \"Graphics/Textures/00_256_013.png\"\nOBJECT TORUS 4, 70, 26\nOBJECT TEXTURE 4, \"Graphics/Textures/Whirl_300_001.png\"\nOBJECT CYLINDER 5, 55, 150\nOBJECT TEXTURE 5, \"Graphics/Textures/Red_GradientCircles_320.png\"\nOBJECT CONE 6, 75, 150\nOBJECT COLOUR 6, \"Gold\"\nOBJECT CONE 7, 85, 130, 4          ; a cone with four sides is a pyramid\nOBJECT TEXTURE 7, \"Graphics/Textures/256_001.png\"\n\n; The shapes stand in a ring, each on the floor\nNS = 6\nDIM SY(NS)\nSY(1) = 35 : SY(2) = 25 : SY(3) = 0 : SY(4) = 25 : SY(5) = 25 : SY(6) = 35\nFOR I = 1 TO NS\n  A = I * 60\n  OBJECT POS I + 1, SIN(A) * 330, SY(I), COS(A) * 330\nNEXT I\n\nLIGHT -1, -1.5, -0.5, 30\nCAMERA LOOK 0, 0, 0\n\nSCREEN SELECT 1\nFONT LOAD 0, \"Graphics/Fonts/32/015_32.png\", 32, 32\nFONT MAP 0, \" !~#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\"\nFONT PRINT 0, 160, 20, \"OBJECT 3D\"\n\nT = 0\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nLoop:\n  T = T + 1\n  ; The camera goes round at a height that rises and falls\n  A = T * 0.4\n  CAMERA POS SIN(A) * 800, -260 + SIN(T * 0.7) * 120, COS(A) * 800\n\n  OBJECT ROTATE 2, T, T * 1.5, 0\n  OBJECT ROTATE 3, 0, T * 2, 0\n  OBJECT ROTATE 4, 70, T * 2, T\n  OBJECT ROTATE 5, 0, T * 2, 0\n  OBJECT ROTATE 6, 0, T * 3, 0\n  OBJECT ROTATE 7, 0, -T * 2, 0\n  WAIT VBL\nGOTO Loop\n", "ScreenWidth": null, "ScreenHeight": null, "Sprites": null, "MapWidth": null, "MapHeight": null, "MapData": null}