{"Version": 2, "ProgramText": "; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  STARFIGHTER\n;\n;  A spaceship loaded from a 3D model file. Starfighter.obj is a\n;  Wavefront .obj file, the kind Blender and most 3D programs can\n;  save, and Starfighter.png is the picture its faces are painted\n;  with. The ship turns slowly so you can see it from every side,\n;  while rocks rush past and a cloudy planet turns far away.\n;\n;  Make your own ship in Blender, save it as .obj (with \"UV\n;  coordinates\" on) and change the two file names below.\n;\n;  Layer 0: space (raster)\n;  Layer 1: the planet, the rocks and the ship (OBJECT)\n;  Layer 2: the title\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nSCREEN 640,480\nMUSIC PLAY \"Sound/Tracker/XM/EnergyGods.XM\"\n\nSCREEN SELECT 0\nRASTER CLEAR\nRASTER 1, 0, 0, 480, \"#000008, #0A0A30\"\nRASTER SPACE 0, 1\n\n; OBJECTs go in the layer that is selected when they are made\nSCREEN SELECT 1\n; The planet, far away\nOBJECT SPHERE 1, 1100, 40\nOBJECT TEXTURE 1, \"Graphics/Textures/Blue_Clouds_320.png\"\nOBJECT POS 1, -2600, -900, 7000\n\n; The ship\nOBJECT LOAD 2, \"Graphics/Models/Starfighter.obj\"\nOBJECT TEXTURE 2, \"Graphics/Models/Starfighter.png\"\nOBJECT ZOOM 2, 145\n\n; Rocks: a sphere with only 6 steps round it gets hard, flat sides\nNR = 8\nDIM RX(NR), RY(NR), RZ(NR), RS(NR)\nFOR I = 1 TO NR\n  OBJECT SPHERE I + 2, 20 + RND(30), 6\n  OBJECT COLOUR I + 2, \"#9A8C78\"\n  OBJECT ZOOM I + 2, 100, 70 + RND(40), 80 + RND(40)\n  GOSUB NewRock\n  RZ(I) = 600 + I * 400\nNEXT I\n\nLIGHT -1, -0.8, -1, 25\n\nSCREEN SELECT 2\nFONT LOAD 0, \"Graphics/Fonts/32/015_32.png\", 32, 32\nFONT MAP 0, \" !~#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\"\nFONT PRINT 0, 144, 20, \"STARFIGHTER\"\nINKG \"#8090C0\"\nTEXT 180, 450, \"A ship from a Starfighter.obj file\"\n\nT = 0\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nLoop:\n  T = T + 1\n  ; The ship turns round, tips its nose up and down and rolls a little\n  OBJECT ROTATE 2, SIN(T * 0.9) * 20, T * 0.6 + 200, SIN(T * 1.3) * 15\n  OBJECT POS 2, SIN(T * 0.5) * 40, SIN(T * 0.8) * 20, 420\n\n  ; The rocks come at the camera and start again far away\n  FOR I = 1 TO NR\n    RZ(I) = RZ(I) - RS(I)\n    IF RZ(I) < 40 THEN GOSUB NewRock\n    OBJECT POS I + 2, RX(I), RY(I), RZ(I)\n    OBJECT ROTATE I + 2, T * RS(I) * 0.3, T * 0.7 + I * 40, I * 25\n  NEXT I\n\n  OBJECT ROTATE 1, 0, T * 0.05, 15\n  WAIT VBL\nGOTO Loop\n\n; A rock far away, never in the middle where the ship is\nNewRock:\n  A = RND(360)\n  D = 330 + RND(250)\n  RX(I) = COS(A) * D\n  RY(I) = SIN(A) * D * 0.7\n  RZ(I) = 3200 + RND(600)\n  RS(I) = 12 + RND(10)\nRETURN\n", "ScreenWidth": null, "ScreenHeight": null, "Sprites": null, "MapWidth": null, "MapHeight": null, "MapData": null}