{"Version":2,"ProgramText":"SCREEN 640,480\n\nMUSIC PLAY \u0022Sound/xmasmix.mod\u0022\n\nFONT LOAD 0, \u0022Graphics/font.png\u0022, 32, 25\nFONT MAP 0, \u0022ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00A3$%.\u2019[]\u201D,-\u0022\n\nFONT ZOOM 0, 200,200\nFONT PRINT 0,150,160,\u0022MERRY\u0022\nFONT PRINT 0,30,220,\u0022CHRISTMAS\u0022\n\nLOAD #2,\u0022Graphics/Layer/FlowerMaskWhite.png\u0022\nRASTER #2,1,0,Y,480,\u0022Red,Orange, Yellow, Green, Blue, Indigo, Violet, Red\u0022\nRASTER WRAP #2,1,1      ; Rasterid, on/off\nRASTER GFXMODE 2,1   ; Layerid, on/off\n  \nY=0\nMainLoop:\n  PARTICLE 1,40\n\n  RASTER MOVE #2,1,Y\n  Y=Y-1\n  IF Y=-480 THEN Y=0\n\n  WAIT VBL\nGOTO MainLoop\n\n","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}