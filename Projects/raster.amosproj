{"Version":2,"ProgramText":"SCREEN 640,480\n\nMUSIC PLAY \u0022Sound/xmasmix.mod\u0022\n\nFONT LOAD 0, \u0022Graphics/font.png\u0022, 32, 25\nFONT MAP 0, \u0022ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00A3$%.\u2019[]\u201D,-\u0022\n\nFONT ZOOM 0, 200,200\nFONT PRINT 0,150,160,\u0022MERRY\u0022\nFONT PRINT 0,30,220,\u0022CHRISTMAS\u0022\n\nLOAD \u0022Graphics/Layer/FlowerMaskWhite.png\u0022\n\nDOUBLE BUFFER\n\nY=0\nMainLoop:\n  PARTICLE 1,40\n  RASTER 21, 0, 1, 0 \n  RASTER 1,0,Y,80\n  RASTER STR(1)=\u0022Red,Orange\u0022\n  RASTER 2,0,Y\u002B80,80\n  RASTER STR(2)=\u0022Orange,Yellow\u0022\n  RASTER 3,0,Y\u002B160,80\n  RASTER STR(3)=\u0022Yellow,Green\u0022\n  RASTER 4,0,Y\u002B240,80\n  RASTER STR(4)=\u0022Green,Blue\u0022\n  RASTER 5,0,Y\u002B320,80\n  RASTER STR(5)=\u0022Blue,Indigo\u0022\n  RASTER 6,0,Y\u002B400,80\n  RASTER STR(6)=\u0022Indigo, Violet\u0022\n  RASTER 7,0,Y\u002B480,80\n  RASTER STR(7)=\u0022Violet, Red\u0022\n\n\n  RASTER 8,0,Y\u002B0\u002B560,80\n  RASTER STR(8)=\u0022Red,Orange\u0022\n  RASTER 9,0,Y\u002B80\u002B560,80\n  RASTER STR(9)=\u0022Orange,Yellow\u0022\n  RASTER 10,0,Y\u002B160\u002B560,80\n  RASTER STR(10)=\u0022Yellow,Green\u0022\n  RASTER 11,0,Y\u002B240\u002B560,80\n  RASTER STR(11)=\u0022Green,Blue\u0022\n  RASTER 12,0,Y\u002B320\u002B560,80\n  RASTER STR(12)=\u0022Blue,Indigo\u0022\n  RASTER 13,0,Y\u002B400\u002B560,80\n  RASTER STR(13)=\u0022Indigo, Violet\u0022\n  RASTER 14,0,Y\u002B480\u002B560,80\n  RASTER STR(14)=\u0022Violet, Red\u0022\n\n  Y=Y-1\n  IF Y=-560 THEN Y=0\n\n  WAIT VBL\nGOTO MainLoop\n\n","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}