{"Version": 2, "ProgramText": "; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  SYNTH JUKEBOX\n;\n;  Three songs made with the tracker's instrument library. They use\n;  the second oscillator (detuned saws, fifths) and the LFOs (a\n;  filter that opens and closes in step with the rows, vibrato that\n;  grows in, trills and random bleeps). Open a song with the TRACKER\n;  button to see how it is built, and LIBRARY for the instruments.\n;\n;  1, 2, 3: choose a song     Space: stop and play\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nSCREEN 640,480\nFONT SET 16,16,\"C64 PRO MONO\"\nDIM FILE$(2) : DIM TITLE$(2) : DIM INFO$(2) : DIM COL$(2)\nFILE$(0)=\"Sound/Tracker/acid_sunrise.amostrk\" : TITLE$(0)=\"ACID SUNRISE\" : INFO$(0)=\"ACID BASS  SUPERSAW  808\" : COL$(0)=\"#FF8A3D\"\nFILE$(1)=\"Sound/Tracker/deep_space.amostrk\" : TITLE$(1)=\"DEEP SPACE\" : INFO$(1)=\"DRONE  GLASS PAD  MUSIC BOX\" : COL$(1)=\"#6EC8FF\"\nFILE$(2)=\"Sound/Tracker/pixel_rush.amostrk\" : TITLE$(2)=\"PIXEL RUSH\" : INFO$(2)=\"C64 LEAD  ARPEGGIOS  TRILLS\" : COL$(2)=\"#9CFF6E\"\n\nSONG=0 : PLAYING=1 : LASTKEY$=\"\"\nStartSong\n\nDO\n  ; A key counts once, when it goes down\n  K$=INKEY$\n  IF K$<>LASTKEY$ THEN\n    IF K$=\"D1\" OR K$=\"NumPad1\" THEN SONG=0 : StartSong\n    IF K$=\"D2\" OR K$=\"NumPad2\" THEN SONG=1 : StartSong\n    IF K$=\"D3\" OR K$=\"NumPad3\" THEN SONG=2 : StartSong\n    IF K$=\"Space\" THEN\n      IF PLAYING=1 THEN\n        TRACK STOP : PLAYING=0\n      ELSE\n        TRACK PLAY : PLAYING=1\n      ENDIF\n    ENDIF\n  ENDIF\n  LASTKEY$=K$\n  DrawScreen\n  WAIT VBL\nLOOP\n\nPROC StartSong\n  TRACK STOP\n  TRACK LOAD FILE$(SONG)\n  TRACK LOOP 1\n  TRACK PLAY\n  PLAYING=1\nEND PROC\n\nPROC DrawScreen\n  CLSG\n  ; The three songs, the chosen one in its own colour\n  FOR I=0 TO 2\n    IF I=SONG THEN INKG COL$(I) ELSE INKG 12\n    PRINTG AT 6, 6+I*3, STR$(I+1) & \"  \" & TITLE$(I)\n    IF I=SONG THEN INKG 15 : PRINTG AT 9, 7+I*3, INFO$(I)\n  NEXT I\n  INKG 14\n  PRINTG AT 6, 2, \"SYNTH JUKEBOX\"\n  INKG 12\n  PRINTG AT 6, 26, \"1-3 CHOOSE   SPACE STOP/PLAY\"\n  ; The bar the song is in: 16 steps, the row it is on lit up, brighter on the beats\n  ROW=TRACKROW() MOD 16\n  FOR S=0 TO 15\n    X=96+S*28\n    IF PLAYING=1 AND S<=ROW THEN\n      INKG COL$(SONG)\n      IF S MOD 4=0 THEN H=40 ELSE H=24\n    ELSE\n      INKG 11\n      H=8\n    ENDIF\n    BAR X, 380-H, X+20, 380\n  NEXT S\n  INKG 12\n  IF PLAYING=1 THEN PRINTG AT 6, 20, \"PART \" & STR$(TRACKPOS()+1) & \"   ROW \" & STR$(TRACKROW()) ELSE PRINTG AT 6, 20, \"STOPPED\"\nEND PROC\n", "ScreenWidth": null, "ScreenHeight": null, "Sprites": null, "MapWidth": null, "MapHeight": null, "MapData": null}