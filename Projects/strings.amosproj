{"Version":2,"ProgramText":"A$ = \u0022 GO NORTH \u0022\nPRINT A$\nPRINT TRIM$(A$) \nPRINT LEN(A$)\nPRINT LOWER$(A$)\nPRINT LEFT$(A$,3)\nPRINT RIGHT$(A$,3)\nPRINT MID$(A$,3,3)\nPRINT INSTR(A$,\u0022NORTH\u0022)\nPRINT WORD$(A$,2)\nPRINT REPLACE$(A$,\u0022NORTH\u0022,\u0022SOUTH\u0022)","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}