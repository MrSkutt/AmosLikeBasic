{"Version":2,"ProgramText":"SCREEN 640,480\n\nRASTER #1,1,0,0,480,\"Blue,Black\"\nRASTER GFXMODE 1,0 \n\nSAM PLAY \"Sound/Scout.mp3\"\n\nINKG WHITE\nFONT SET 70,100,\"Courier New\"\nFONT STYLE \"Bold Italic\"\nPRINTG AT 1,7,\"PHALANX\"\nPRINTG AT 2,8,\"RULES\"\n\nSCREEN SELECT 1\nINKG Red\nFONT SET 100,130,\"Courier New\"\nFONT STYLE \"Bold Italic\"\nPRINTG AT 0,0,\"HI THERE\"\nSCREEN SELECT 0\n\nPARTICLE 2,40\nRASTER GFXMODE 0,1 \nRASTER 1,0,Y,480,\"Red,Orange,Yellow,Green,Blue,Indigo,Violet,Red\"\n\nY=0 : VY=0 : VX=0\nMainLoop:\n  Y=Y-1\n  IF Y=-480 THEN Y=0\n\n  SCROLL 0,SIN(VX)*20,SIN(-VY)*200-190\n  VY=VY+1\n  IF VY=180 THEN VY=0\n  \n  VX=VX+10\n  IF VX=360 THEN VX=0\n    \n  WAIT VBL\nGOTO MainLoop\n"}