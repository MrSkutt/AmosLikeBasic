{"Version":2,"ProgramText":"SCREEN 640,480\n\nIMAGE LOAD 1, \u0022Graphics/hero.png\u0022     ; Laddas EN g\u00E5ng\n\nFOR i = 1 TO 20\n    SPRITE POS i, RND(640), RND(480)\n    SPRITE IMAGE i, 1          ; Alla pekar p\u00E5 samma bild\n    SPRITE ZOOM i,200,200\n    SPRITE ON i\nNEXT i\n\nLoop:\nFOR i = 1 TO 20\n    SPRITE IMAGE i, 1          ; Alla pekar p\u00E5 samma bild\n    SPRITE ON i\nNEXT i\n\nwait vbl\nGOTO Loop\n","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}