{"Version":2,"ProgramText":"\nFONT LOAD 0, \"Graphics/font.png\", 32, 25\nFONT MAP 0, \"ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00a3$%.\u2019[]\u201d,-\"\n\nFONT PRINT #1,0,100,100,\"HELLO\"\n\nX=0\nWhile 1\n   SCROLL 0,X,0\n   INC X\n   IF X=640 THEN X=0\n   WAIT VBL\nWEND","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}