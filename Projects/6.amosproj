{"Version":2,"ProgramText":"LOAD \u0022Graphics/berg.png\u0022\n\nIMAGE LOAD 1,\u0022Graphics/hero.png\u0022\nSPRITE #1,1,0,0,1\n\nIMAGE LOAD 2,\u0022Graphics/Logos/RedSector_1.png\u0022\nSPRITE #0,2,0,0,2\nSPRITE #1,3,0,50,2\n\nX=0\nWhile 1\n   SCROLL 0,X,0\n   INC X\n   IF X=640 THEN X=0\n   WAIT VBL\nWEND","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}