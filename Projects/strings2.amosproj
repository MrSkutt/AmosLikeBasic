{"Version":2,"ProgramText":"REM Make a string array with SPLIT$\nDIM parts$(4)\nparts$ = SPLIT$(\"Anna,Erik,Lisa,Kalle\", \",\")\n\nREM Print single elements\nFOR I=0 TO DIM(parts$)-1\n  PRINT parts$(i)\nNEXT I\n\n\nREM Join them again with JOIN$\nresult$ = JOIN$(parts$, \" and \")\nPRINT result$  ; \"Anna and Erik and Lisa and Kalle\"\n\nREM Works with numeric arrays too\nDIM numbers(3)\nnumbers(0) = 100\nnumbers(1) = 200\nnumbers(2) = 300\n\ncsv$ = JOIN$(numbers, \",\")\nPRINT csv$  ; \"100,200,300\"\n\nREM Split a sentence\nDIM words$(20)\nwords$ = SPLIT$(\"This is a test and that is that\", \" \")\nFOR i = 0 TO DIM(words$)-1\n    PRINT i & \": \" & words$(i)\nNEXT i","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}