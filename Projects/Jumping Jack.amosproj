{"Version":2,"ProgramText":"TILEW = 16\nFLOORTILES = 32\nGROUNDY = 150\n\nSTATEGROUND = 0\nSTATEJUMP   = 1\n\nGRAVITY = 0.5\nJUMPFORCE = 8\n\nDIM floor(FLOORTILES)\n\nplayerX = 120\nplayerY = GROUNDY\nvelY = 0\nplayerState = STATE_GROUND\n\nscrollCounter = 0\nscrollSpeed = 4     ; l\u00E4gre = snabbare scroll\n\nFOR i = 0 TO FLOORTILES-1\n    floor(i) = 1\nNEXT\n\nWHILE 1\n    UpdateScroll\n    UpdatePlayer\n    CheckCollision\n    Render\nWEND\n\n\nPROC UpdateScroll\n\n    scrollCounter = scrollCounter \u002B 1\n    IF scrollCounter \u003C scrollSpeed THEN EXIT PROCEDURE\n    scrollCounter = 0\n\n    FOR i = 0 TO FLOORTILES-2\n        floor(i) = floor(i\u002B1)\n    NEXT\n    \n    ; Newtilr\n    r = RND(10)\n    IF r \u003C 2 THEN\n      A=0\n    ELSE\n      A=1\n    ENDIF\n    floor(FLOORTILES-1) = A\n\nEND PROC\n\n\nFUNCTION NewTile(a)\n\n    r = RND(10)\n\n    IF r \u003C 2 THEN\n        RETURN 0\n    ENDIF\n\n    RETURN 1\n\nEND FUNCTION\n\n\nPROC UpdatePlayer\n\n    ; Hoppa\n    IF KeyState(\u0022SPACE\u0022) AND playerState = STATEGROUND THEN\n        velY = -JUMPFORCE\n        playerState = STATE_JUMP\n    ENDIF\n\n    ; Gravitation\n    velY = velY \u002B GRAVITY\n    playerY = playerY \u002B velY\n\n    ; Landning\n    IF playerY \u003E= GROUNDY THEN\n        playerY = GROUNDY\n        velY = 0\n        playerState = STATE_GROUND\n    ENDIF\n\nEND PROC\n\n\nPROC CheckCollision\n\n    tileIndex = (playerX \u002B TILEW/2) / TILEW\n\n    IF tileIndex \u003C 0 OR tileIndex \u003E= FLOORTILES THEN EXIT PROCEDURE\n\n    IF floor(tileIndex) = 0 AND playerState = STATEGROUND THEN\n        GameOver\n    ENDIF\n\nEND PROC\n\nPROC Render\n\n    CLS\n\n    FOR i = 0 TO FLOORTILES-1\n\n        IF floor(i) = 1 THEN\n            ;DrawBlock(i*TILEW, GROUNDY)\n        ENDIF\n\n    NEXT\n\n    ;DrawPlayer(playerX, playerY)\n\nEND PROC\n\n\nPROC GameOver\n    PRINT \u0022GAME OVER\u0022\n    END\nEND PROC\n","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}