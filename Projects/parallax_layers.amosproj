{"Version":2,"ProgramText":"; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n;  PARALLAX LAYERS\n;\n;  Five layers on top of each other, each scrolling at its own\n;  speed: the farther away, the slower. That is what gives depth.\n;\n;  Every layer is 640 pixels wide and repeats when it scrolls, so\n;  everything is drawn so that the right edge meets the left edge.\n;  The mountains are sums of sine waves that fit exactly into 640\n;  pixels (0.5625 degrees per pixel is one whole wave), and trees\n;  near an edge are drawn a second time on the other side.\n;\n;  Left/right: slower/faster (and backwards)    Space: stop\n; \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nSCREEN 640,480\n\nDrawSky\nDrawMountains 1,\"#6b4a8c\",250,0.5625,36,1.6875,16,10\nDrawMountains 2,\"#4a3570\",300,1.125,28,2.8125,10,50\nDrawMountains 3,\"#2c2350\",350,1.6875,18,3.9375,6,120\nDrawForeground\n\nX=0 : SPEED=2\nLoop:\n  IF KEYSTATE(\"Right\")=1 THEN SPEED=SPEED+0.05\n  IF KEYSTATE(\"Left\")=1 THEN SPEED=SPEED-0.05\n  IF KEYSTATE(\"Space\")=1 THEN SPEED=0\n  IF SPEED>8 THEN SPEED=8\n  IF SPEED<-8 THEN SPEED=-8\n  X=X+SPEED\n  ; The front layer moves X pixels; every layer behind it half as far\n  SCROLL 1,X/8,0\n  SCROLL 2,X/4,0\n  SCROLL 3,X/2,0\n  SCROLL 4,X,0\n  WAIT VBL\nGOTO Loop\n\n\n; \u2500\u2500 Layer 0: the sky. Raster colours stay put while the rest scrolls \u2500\u2500\nPROC DrawSky\n  SCREEN SELECT 0\n  RASTER 1,0,0,300,\"#0b1236,#3b2a6b,#c0506b,#f6a05a\"\n  RASTER 2,0,300,180,\"#f6a05a,#ffd59a\"\n  INKG \"#ffe9b0\"\n  CIRCLEF 320,240,46,46\n  INKG \"#fff6dc\"\n  CIRCLEF 320,240,36,36\nEND PROC\n\n; \u2500\u2500 Layers 1-3: a mountain range of two sine waves \u2500\u2500\n; TOP is the mean height, F1/A1 and F2/A2 the frequency (degrees per\n; pixel, a multiple of 0.5625) and size of each wave, P a phase shift\nPROC DrawMountains(L,COL$,TOP,F1,A1,F2,A2,P)\n  SCREEN SELECT L\n  INKG COL$\n  FOR X=0 TO 638 STEP 2\n    H=SIN(X*F1+P)*A1+SIN(X*F2+P*2)*A2\n    BAR X,INT(TOP-H),X+1,479\n  NEXT X\nEND PROC\n\n; \u2500\u2500 Layer 4: the ground and fir trees in front \u2500\u2500\nPROC DrawForeground\n  SCREEN SELECT 4\n  INKG \"#0d1020\"\n  BAR 0,420,639,479\n  RESTORE TreeData\n  FOR I=1 TO 8\n    READ TX,TS\n    Tree TX,TS\n    IF TX<40 THEN Tree TX+640,TS\n    IF TX>600 THEN Tree TX-640,TS\n  NEXT I\nEND PROC\n\n; A fir tree standing on the ground at TX, TS pixels tall\nPROC Tree(TX,TS)\n  INKG \"#0d1020\"\n  BAR TX-3,420-TS/5,TX+3,420\n  FOR R=0 TO TS STEP 2\n    W=R/3\n    BAR TX-W,420-TS+R,TX+W,421-TS+R\n  NEXT R\nEND PROC\n\nTreeData:\nDATA 20,90, 95,60, 150,110, 260,70, 330,95, 420,55, 490,120, 620,80\n","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}