{"Version":2,"ProgramText":"SCREEN 640, 480\n\nMUSIC PLAY \"Sound/mus2.mod\"\n\nLOAD #1,\"Graphics/berg.png\"\n\nSCREEN SELECT 3\nSPRITE LOAD 1, \"Graphics/hero.png\"\nSPRITE ON 1\nSPRITE LAYER 1,3\n\nSCREEN SELECT 2\n\n; Create MAP 100x15\nTILE MAP 100, 15\nTILE LOAD \"Graphics/tileset.png\", 32, 32\nMAP LOAD \"Graphics/test.amosmap\"\n\n; Draw the whole level ONCE\n;FOR X = 0 TO 99\n;  TILE SET X, 2, 2\n;NEXT X\nTILE DRAW 0, 0\nSCREEN SELECT 0\n\n;PARTICLE 3,20\nLET MAXSX = 3200\n\nLET SX = 0 : LET SY = 0\nLET Y = 0 : LET VY = 0\nLET ONGROUND = 0\n\nMainLoop:\n  RASTER 1,0,0,480,\"Black, #220000, Red\"\n  \n  ; 1. Check the limits of the level\n  IF SX < 0 THEN LET SX = 0\n  ;IF SX > MAXSX THEN LET SX = MAXSX  ; No longer works for some odd reason.\n\n  ; 2. Check if we jump into a block\n  IF TILE(1, 320+16+SX, Y-8) > -1\n    PLAY COIN\n    LET VY=1\n    LET Y = Y + VY\n  ENDIF  \n             \n  ; 3. Check ground contact (before we move the player)\n  ; Check if we STAND on something (VY is 0 or positive when falling)\n  IF TILE(1, 320+16+SX, Y+32+24) > -1\n    LET VY = 0\n    LET Y = INT(Y / 32) * 32+16               \n    LET ONGROUND = 1 \n  ELSE \n    LET ONGROUND = 0\n  ENDIF\n\n  ; 4. Check if we walk into something on the right\n  IF KEYSTATE(\"D\") OR JOYSTATE(1, \"Right\") OR JOYAXIS(1, \"LeftX\") > 0\n    IF TILE(1, 320+48+SX, Y+32) = -1\n      LET SX = SX + 8\n    ENDIF\n  ENDIF\n\n  ; 5. Check if we walk into something on the left\n  IF (KEYSTATE(\"A\") OR JOYSTATE(1, \"Left\")) OR JOYAXIS(1, \"LeftX\") < 0\n    IF TILE(1, 320+SX,  Y +32)  = -1\n      LET SX = SX - 8\n    ENDIF\n  ENDIF\n\n  ; 6. Apply gravity and move (only when in the air)\n  IF ONGROUND = 0\n    LET VY = VY + 1\n    LET Y = Y + VY\n  ENDIF\n\n  ; 7. Jump (only when standing on the ground)\n  IF (KEYSTATE(\"SPACE\") OR JOYSTATE(1, \"A\"))\n    IF ONGROUND = 1 \n      PLAY JUMP\n      LET VY = -16\n      LET Y = Y -10\n      LET ONGROUND = 0\n    ENDIF\n  ENDIF\n\n  ; 8. Draw everything\n  SCROLL 0, SX/2, 0\n  SCROLL 1, SX/2, 0\n  SCROLL 2, SX, 0\n\n  SPRITE ROTATE 1,VY*2                                \n  SPRITE POS 1, 320, Y\n  WAIT VBL\nGOTO MainLoop\n\n\n","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}