{
  "Version": 2,
  "ProgramText": "; ════════════════════════════════════════════════════════════════\n;  GRODHOPP\n;\n;  Hjälp grodan Kvack upp till toppen! I varje golv finns hål som\n;  glider åt sidan. Hoppa när ett hål är ovanför dig. Hoppar du\n;  när det inte finns något hål slår du i taket och blir yr, och\n;  står du där ett hål kommer faller du ned en våning.\n;  Från nivå 2 flyger getingar längs golven. Akta dig för dem!\n;\n;  Vänster/höger: gå    Mellanslag eller upp: hoppa\n;\n;  Allt ritas med kod varje bild, så spelet behöver inga bilder.\n;  Lager 1 och 2 turas om: spelet ritar i det som inte syns och\n;  byter sedan, så att man aldrig ser en halvfärdig bild.\n;  Musiken och ljuden är gjorda i trackern (Sound/Tracker).\n; ════════════════════════════════════════════════════════════════\n\n; ── Konstanter ──────────────────────────────────────────────────\nFLOORS=7          ; golv 1 – 7 har hål, golv 0 är marken\nGAP=50            ; avstånd mellan golven\nHW=60             ; hålens bredd\nGRAV=0.55 : JUMPV=-8.6 : WALK=3\n\nDIM LH(8)         ; antal hål i varje golv\nDIM LS(8)         ; hålens fart i varje golv (minus = åt vänster)\nDIM LX(8,3)       ; hålens x-position, upp till tre hål per golv\nDIM LC$(8)        ; golvens färger\nDIM WX(4)         ; getingarna: x, golv och fart\nDIM WF(4)\nDIM WS(4)\n\nLC$(0)=\"#6C5EB5\" : LC$(1)=\"#A1683C\" : LC$(2)=\"#68A141\" : LC$(3)=\"#9AD284\"\nLC$(4)=\"#6ABFC6\" : LC$(5)=\"#C46C71\" : LC$(6)=\"#C9D487\" : LC$(7)=\"#FFFFFF\"\n\n; ── Bakgrund: natthimmel med stjärnor i lager 0 ─────────────────\nSCREEN SELECT 0\nRASTER 1,0,0,480,\"#0B0B3B, #2A1B5E, #4B2A7A\"\nPARTICLE 3,8\nFONT SET 16,16,\"C64 PRO MONO\"\n\nTRACK SFX LOAD \"Sound/Tracker/ljud.amostrk\"\nHISCORE=0 : SC=0 : LIVES=3\nMODE=0 : T=0\nTitleMusic\nSetupLevel 1\n\n; ════════════════════════════════════════════════════════════════\n;  Huvudloop. MODE: 0 titel, 1 spel, 2 nivån klar, 3 game over\n; ════════════════════════════════════════════════════════════════\nMainLoop:\n  T=T+1\n  IF MODE=0 THEN TitleFrame\n  IF MODE=1 THEN PlayFrame\n  IF MODE=2 THEN LevelDoneFrame\n  IF MODE=3 THEN GameOverFrame\n  MoveHoles\n  MoveWasps\n  Draw\n  WAIT VBL\nGOTO MainLoop\n\nPROC TitleFrame\n  IF KEYSTATE(\"Space\")=1 OR KEYSTATE(\"Return\")=1 OR JOYSTATE(1,\"A\")=1 THEN NewGame\nEND PROC\n\nPROC PlayFrame\n  ReadInput\n  MovePlayer\n  CheckWasps\nEND PROC\n\nPROC LevelDoneFrame\n  WT=WT+1\n  IF WT>120 THEN\n    SetupLevel LEVEL+1\n    MODE=1\n  ENDIF\nEND PROC\n\nPROC GameOverFrame\n  WT=WT+1\n  IF WT>360 THEN\n    MODE=0\n    TitleMusic\n  ENDIF\nEND PROC\n\n; ════════════════════════════════════════════════════════════════\n;  Nytt spel och nya nivåer\n; ════════════════════════════════════════════════════════════════\nPROC NewGame\n  SC=0 : LIVES=3\n  SetupLevel 1\n  MODE=1\n  TRACK LOAD \"Sound/Tracker/grodhopp.amostrk\"\n  TRACK LOOP 1\n  TRACK PLAY\nEND PROC\n\nPROC TitleMusic\n  TRACK LOAD \"Sound/Tracker/grodhopp.amostrk\"\n  TRACK LOOP 1\n  TRACK PLAY\n  TRACK VOLUME 0.6\nEND PROC\n\n; Varje nivå får fler hål, snabbare hål och fler getingar\nPROC SetupLevel(N)\n  LEVEL=N\n  TRACK VOLUME 1\n  FOR L=1 TO FLOORS\n    LH(L)=1\n    IF LEVEL>=2 AND L MOD 2=0 THEN LH(L)=2\n    IF LEVEL>=4 AND L MOD 2=1 THEN LH(L)=2\n    IF LEVEL>=6 AND L MOD 3=0 THEN LH(L)=3\n    SPD=1+LEVEL*0.25+RND(10)/10\n    IF SPD>4 THEN SPD=4\n    IF L MOD 2=0 THEN SPD=-SPD\n    LS(L)=SPD\n    ; Hålen i ett golv sprids jämnt, så att de aldrig går ihop\n    START=RND(640)\n    FOR K=0 TO LH(L)-1\n      LX(L,K)=(START+K*640/LH(L)) MOD 640\n    NEXT K\n  NEXT L\n  NW=LEVEL-1\n  IF NW>4 THEN NW=4\n  ; FOR körs minst en gång, så hoppa över loopen när det inte finns getingar\n  IF NW=0 THEN\n    StartPlayer\n    EXIT PROC\n  ENDIF\n  FOR K=0 TO NW-1\n    WF(K)=2+K\n    WX(K)=RND(640)\n    WS(K)=1.5+RND(10)/10\n    IF K MOD 2=1 THEN WS(K)=-WS(K)\n  NEXT K\n  StartPlayer\nEND PROC\n\nPROC StartPlayer\n  PX=320 : PF=0 : PY=FloorY(0) : VY=0\n  STATE=0      ; 0 står, 1 hoppar, 2 faller, 3 yr\n  STUN=0 : SAFE=90 : JHELD=1 : FACE=1\n  BEST=0\nEND PROC\n\nFUNCTION FloorY(F)\n  RETURN 440-F*GAP\nEND FUNCTION\n\n; ════════════════════════════════════════════════════════════════\n;  Grodan\n; ════════════════════════════════════════════════════════════════\nPROC ReadInput\n  LK=0 : RK=0 : JK=0\n  IF KEYSTATE(\"Left\")=1 OR JOYSTATE(1,\"Left\")=1 THEN LK=1\n  IF KEYSTATE(\"Right\")=1 OR JOYSTATE(1,\"Right\")=1 THEN RK=1\n  IF KEYSTATE(\"Space\")=1 OR KEYSTATE(\"Up\")=1 OR JOYSTATE(1,\"A\")=1 THEN JK=1\nEND PROC\n\nPROC MovePlayer\n  IF SAFE>0 THEN SAFE=SAFE-1\n\n  ; Yr: står still tills stjärnorna slutar snurra\n  IF STATE=3 THEN\n    STUN=STUN-1\n    IF STUN<=0 THEN STATE=0\n    JHELD=JK\n    EXIT PROC\n  ENDIF\n\n  ; Gå åt sidan, och kom in på andra sidan skärmen\n  SPEEDX=WALK\n  IF STATE<>0 THEN SPEEDX=WALK*0.6\n  IF LK=1 THEN PX=PX-SPEEDX : FACE=-1\n  IF RK=1 THEN PX=PX+SPEEDX : FACE=1\n  IF PX<0 THEN PX=PX+640\n  IF PX>=640 THEN PX=PX-640\n\n  IF STATE=0 THEN\n    ; Hoppa, men bara en gång per knapptryck\n    IF JK=1 AND JHELD=0 AND PF<FLOORS THEN\n      STATE=1 : VY=JUMPV\n      TRACK SFX \"Hopp\", \"C-4\"\n    ELSE\n      ; Står grodan där ett hål kommer faller den ned\n      IF PF>0 THEN\n        InHole PF, PX, 10\n        IF HIT=1 THEN\n          STATE=2 : VY=0 : PF=PF-1\n          TRACK SFX \"Fall\", \"C-6\"\n        ENDIF\n      ENDIF\n    ENDIF\n  ENDIF\n  JHELD=JK\n\n  IF STATE=1 OR STATE=2 THEN\n    VY=VY+GRAV\n    PY=PY+VY\n    ; Huvudet når golvet ovanför: finns det ett hål där?\n    IF STATE=1 AND VY<0 AND PY-26<=FloorY(PF+1)+8 THEN\n      InHole PF+1, PX, 4\n      IF HIT=1 THEN\n        PF=PF+1\n        IF PF>BEST THEN\n          BEST=PF\n          SC=SC+10*LEVEL\n        ENDIF\n      ELSE\n        ; Bonk! Tillbaka ned och yr en stund\n        PY=FloorY(PF+1)+34 : VY=1 : STATE=2\n        STUN=45\n        TRACK SFX \"Bonk\", \"C-3\"\n      ENDIF\n    ENDIF\n    ; Landa på golvet\n    IF VY>0 AND PY>=FloorY(PF) THEN\n      PY=FloorY(PF) : VY=0\n      IF STUN>0 THEN\n        STATE=3\n      ELSE\n        STATE=0\n      ENDIF\n      IF PF=FLOORS THEN LevelDone\n    ENDIF\n  ENDIF\nEND PROC\n\n; Sätter HIT till 1 om det finns ett hål i golvet L där grodan (x, med marginal M) får plats\nPROC InHole(L, X, M)\n  HIT=0\n  FOR K=0 TO LH(L)-1\n    D=X-LX(L,K)\n    IF D<0 THEN D=D+640\n    IF D>=M AND D<=HW-M THEN HIT=1\n  NEXT K\nEND PROC\n\nPROC LevelDone\n  MODE=2 : WT=0\n  SC=SC+100*LEVEL\n  TRACK SFX \"Klar\", \"C-5\"\nEND PROC\n\n; ════════════════════════════════════════════════════════════════\n;  Hålen och getingarna\n; ════════════════════════════════════════════════════════════════\nPROC MoveHoles\n  FOR L=1 TO FLOORS\n    FOR K=0 TO LH(L)-1\n      X=LX(L,K)+LS(L)\n      IF X<0 THEN X=X+640\n      IF X>=640 THEN X=X-640\n      LX(L,K)=X\n    NEXT K\n  NEXT L\nEND PROC\n\nPROC MoveWasps\n  IF NW=0 THEN EXIT PROC\n  FOR K=0 TO NW-1\n    X=WX(K)+WS(K)\n    IF X<0 THEN X=X+640\n    IF X>=640 THEN X=X-640\n    WX(K)=X\n  NEXT K\nEND PROC\n\nPROC CheckWasps\n  IF NW=0 OR SAFE>0 OR STATE=1 OR STATE=2 THEN EXIT PROC\n  FOR K=0 TO NW-1\n    IF WF(K)=PF THEN\n      D=ABS(WX(K)-PX)\n      IF D>320 THEN D=640-D\n      IF D<18 THEN LoseLife\n    ENDIF\n  NEXT K\nEND PROC\n\nPROC LoseLife\n  TRACK SFX \"Aj\", \"C-4\"\n  LIVES=LIVES-1\n  IF LIVES<=0 THEN\n    IF SC>HISCORE THEN HISCORE=SC\n    MODE=3 : WT=0\n    TRACK LOAD \"Sound/Tracker/gameover.amostrk\"\n    TRACK LOOP 0\n    TRACK PLAY\n  ELSE\n    StartPlayer\n  ENDIF\nEND PROC\n\n; ════════════════════════════════════════════════════════════════\n;  Ritning: dubbelbuffring med lager 1 och 2\n; ════════════════════════════════════════════════════════════════\nPROC Draw\n  ; Rita i lagret som inte syns just nu\n  BACK=2-T MOD 2\n  SCREEN SELECT BACK\n  CLSG\n  FOR L=0 TO FLOORS\n    DrawFloor L\n  NEXT L\n  IF NW>0 THEN\n    FOR K=0 TO NW-1\n      DrawWasp WX(K), FloorY(WF(K))-14\n    NEXT K\n  ENDIF\n  IF MODE<>0 THEN DrawFrog\n  DrawText\n  ; Byt: visa den nya bilden och göm den gamla\n  SCREEN ON BACK\n  SCREEN OFF 3-BACK\nEND PROC\n\n; Ett golv ritas som bitar mellan hålen\nPROC DrawFloor(L)\n  Y=FloorY(L)\n  INKG LC$(L)\n  IF L=0 THEN\n    BAR 0,Y,639,Y+7\n    EXIT PROC\n  ENDIF\n  ; Hålen i golvet i ordning från vänster\n  N=LH(L)\n  A0=LX(L,0) : A1=LX(L,1) : A2=LX(L,2)\n  IF N>=2 AND A1<A0 THEN SWAP A0,A1\n  IF N=3 THEN\n    IF A2<A0 THEN SWAP A0,A2\n    IF A2<A1 THEN SWAP A1,A2\n  ENDIF\n  ; Mellan hålen\n  IF N>=2 THEN Piece A0+HW, A1, Y\n  IF N=3 THEN Piece A1+HW, A2, Y\n  ; Från sista hålet, runt kanten, till det första\n  LAST=A0\n  IF N=2 THEN LAST=A1\n  IF N=3 THEN LAST=A2\n  E=LAST+HW\n  IF E>=640 THEN\n    Piece E-640, A0, Y\n  ELSE\n    Piece E, 640, Y\n    Piece 0, A0, Y\n  ENDIF\nEND PROC\n\nPROC Piece(X1, X2, Y)\n  IF X2-X1<1 THEN EXIT PROC\n  BAR X1,Y,X2-1,Y+7\nEND PROC\n\nPROC DrawFrog\n  ; Blinkar när grodan nyss har börjat om\n  IF SAFE>0 AND (SAFE/6) MOD 2=1 THEN EXIT PROC\n  X=PX : Y=PY\n  SQ=0\n  IF STATE=1 THEN SQ=3\n  ; Ben\n  INKG \"#2E7D32\"\n  CIRCLEF X-11,Y-3+SQ,6,3\n  CIRCLEF X+11,Y-3+SQ,6,3\n  ; Kropp och mage\n  INKG \"#43A047\"\n  CIRCLEF X,Y-11-SQ,14,11+SQ\n  INKG \"#A5D6A7\"\n  CIRCLEF X+FACE*2,Y-8-SQ,8,5\n  ; Ögon\n  INKG \"#43A047\"\n  CIRCLEF X-7,Y-22-SQ,5,5\n  CIRCLEF X+7,Y-22-SQ,5,5\n  INKG \"#FFFFFF\"\n  CIRCLEF X-7,Y-23-SQ,3,3\n  CIRCLEF X+7,Y-23-SQ,3,3\n  INKG \"#101010\"\n  CIRCLEF X-7+FACE,Y-23-SQ,1.5,1.5\n  CIRCLEF X+7+FACE,Y-23-SQ,1.5,1.5\n  ; Stjärnor som snurrar när den är yr\n  IF STATE=3 THEN\n    INKG \"#FFEB3B\"\n    FOR K=0 TO 2\n      AN=T*12+K*120\n      CIRCLEF X+COS(AN)*16,Y-34+SIN(AN)*4,2.5,2.5\n    NEXT K\n  ENDIF\nEND PROC\n\nPROC DrawWasp(X, Y)\n  ; Vingarna flaxar\n  INKG \"#E0F7FA\"\n  WY=2\n  IF T MOD 6<3 THEN WY=4\n  CIRCLEF X-3,Y-6-WY,5,3\n  CIRCLEF X+3,Y-6-WY,5,3\n  INKG \"#FDD835\"\n  CIRCLEF X,Y,9,6\n  INKG \"#212121\"\n  BAR X-2,Y-6,X,Y+6\n  BAR X+3,Y-5,X+5,Y+5\nEND PROC\n\nPROC DrawText\n  ; C64-fonten har inte Å, Ä och Ö, så texterna klarar sig utan dem\n  INKG \"#FFFFFF\"\n  TEXT 16,8,\"RESULTAT \" & SC\n  TEXT 272,8,\"BANA \" & LEVEL\n  TEXT 528,8,\"LIV \" & LIVES\n  IF MODE=0 THEN\n    INKG \"#1A1240\"\n    BAR 160,156,480,292\n    INKG \"#9AD284\"\n    TEXT 256,170,\"GRODHOPP\"\n    INKG \"#FFFFFF\"\n    TEXT 192,220,\"TRYCK MELLANSLAG\"\n    TEXT 256,260,\"REKORD \" & HISCORE\n  ENDIF\n  IF MODE=2 THEN\n    INKG \"#FFEB3B\"\n    TEXT 232,220,\"BANAN KLAR!\"\n  ENDIF\n  IF MODE=3 THEN\n    INKG \"#FF5252\"\n    TEXT 248,220,\"GAME OVER\"\n  ENDIF\nEND PROC\n"
}