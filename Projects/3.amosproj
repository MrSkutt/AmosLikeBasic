{"Version":2,"ProgramText":"SCREEN SELECT 0\nRASTER CLEAR\nRASTER 1, 0, 0, 480, \u0022Blue, White\u0022\nRASTER GFXMODE 0, FALSE\n\nLOAD \u0022Graphics/berg.png\u0022\n\nSCREEN SELECT 1\nLOAD #1,\u0022Graphics/Layer/FlowerMaskWhite.png\u0022\nRASTER 1, 0, 0, 480, \u0022Red, Orange, Yellow, Green, Blue, Indigo, Violet, Red\u0022\nRASTER GFXMODE 1,TRUE\n\nSCREEN SELECT 2\n    RASTER 1, 0,0,60,\u0022Blue, White, Blue\u0022\n    RASTER 2, 0,20,60,\u0022Blue, White, Blue\u0022\n;  FOR I = 1 TO 9\n;    RASTER I, 0,SIN(Y\u002BI*20)*220\u002B220,40,\u0022Blue, White, Blue\u0022\n ; NEXT I  \n\n\nRASTER INFO\n\nEND\n\nY = 0\nY2=0\nMainLoop:\n  INC Y\n  IF Y=360 THEN Y=0\n  ;FOR I = 2 TO 9\n  ;  RASTER MOVE I, SIN(Y\u002BI*10)*220\u002B220\n  ;NEXT I  \n\n  RASTER MOVE 1,Y2\n  Y2=Y2-10\n  IF Y2=-480 THEN Y2=0\nWAIT VBL\nGOTO MainLoop","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}