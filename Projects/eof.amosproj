{"Version":2,"ProgramText":"REM Create a test file\nOPEN OUT 1, \"names.txt\"\nPRINT #1, \"Anna\"\nPRINT #1, \"Erik\"\nPRINT #1, \"Lisa\"\nCLOSE 1\n\nREM Read all lines until the file ends\nOPEN IN 2, \"names.txt\"\n\nWHILE EOF(2) = 0\n    INPUT #2, name$\n    PRINT \"Name: \" & name$\nWEND\n\nCLOSE 2\n\nREM Alternative with IF\nOPEN IN 3, \"data.txt\"\n\nIF EOF(3) = 0 THEN\n    INPUT #3, value$\n    PRINT value$\nELSE\n    PRINT \"The file is empty or at its end\"\nENDIF\n\nCLOSE 3\n\nREM Count the lines in a file\nOPEN IN 4, \"file.txt\"\ncount = 0\n\nWHILE EOF(4) = 0\n    INPUT #4, line$\n    INC count\nWEND\n\nCLOSE 4\nPRINT \"Lines: \" & count","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}