{"Version":2,"ProgramText":"REM Write to a file\nOPEN OUT 1, \"highscore.txt\"\nPRINT #1, \"Player: Anna\"\nPRINT #1, \"Score: 1000\"\nPRINT #1, \"Level: 5\"\nCLOSE 1\n\nREM Read from a file\nOPEN IN 2, \"highscore.txt\"\nINPUT #2, line1$\nINPUT #2, line2$\nINPUT #2, line3$\nCLOSE 2\n\nPRINT line1$\nPRINT line2$\nPRINT line3$\n\nREM Skriva utan nyrad (semikolon)\nOPEN OUT 3, \"data.txt\"\nPRINT #3, \"Name: \";\nPRINT #3, \"Erik\"\nCLOSE 3\nREM Gives: \"Name: Erik\" on the same line\n\nREM Numeric values\nOPEN OUT 4, \"numbers.txt\"\nscore = 5000\nPRINT #4, score\nCLOSE 4\n\nOPEN IN 5, \"numbers.txt\"\nINPUT #5, loadedScore\nCLOSE 5\nPRINT \"Loaded score: \" & loadedScore","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}