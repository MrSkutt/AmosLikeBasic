{"Version":2,"ProgramText":"FONT LOAD 0, \u0022Graphics/font.png\u0022, 32, 25\nFONT MAP 0, \u0022ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00A3$%.\u2019[]\u201D,-\u0022\nFONT ZOOM 0,199,199\n\nRASTER 1,0,0,480,\u0022Blue, Black\u0022\n\nSCREEN SELECT 1\nRASTER 1,0,0,480,\u0022White, Blue\u0022\nRASTER GFXMODE 1,1\nSCREEN SELECT 0\n\nRASTER \nVY=180\nVX=0\nLoop:\n  FONT CLEAR\n  FONT ROTATE 0,0\n  FONT PRINT  #0, 0, 1, SIN(VY)*180\u002B200, \u0022HELLO AMOS\u0022\n  FONT ROTATE 0,180\n  FONT PRINT  #1, 0, SIN(VX)*2, SIN(VY-180)*180\u002B240, \u0022HELLO AMOS\u0022\n  \n  VX=VX\u002B20\n  IF VX=360 THEN VX=0\n  \n  INC VY\n  IF VY=360 THEN VY=180\n  WAIT VBL\nGOTO Loop","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}