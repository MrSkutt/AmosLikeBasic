{"Version":2,"ProgramText":"; Music: funky, with a filtered sawtooth melody. Open the file with the TRACKER button to see it.\nTRACK LOAD \"Sound/Tracker/shadow_play.amostrk\"\nTRACK PLAY\n\nFONT LOAD 0, \"Graphics/font.png\", 32, 25\nFONT MAP 0, \"ABCDEFGHIJKLMNOPQRSTUVWXYZ!?:;0123456789@()\u00a3$%.\u2019[]\u201d,-\"\nFONT ZOOM 0,199,199\n\nRASTER 1,0,0,480,\"Blue, Black\"\n\nSCREEN SELECT 1\nRASTER 1,0,0,480,\"White, Blue\"\nRASTER GFXMODE 1,1\nSCREEN SELECT 0\n\nRASTER \nVY=180\nVX=0\nLoop:\n  FONT CLEAR\n  FONT ROTATE 0,0\n  FONT PRINT  #0, 0, 1, SIN(VY)*180+200, \"HELLO AMOS\"\n  FONT ROTATE 0,180\n  FONT PRINT  #1, 0, SIN(VX)*2, SIN(VY-180)*180+240, \"HELLO AMOS\"\n  \n  VX=VX+20\n  IF VX=360 THEN VX=0\n  \n  INC VY\n  IF VY=360 THEN VY=180\n  WAIT VBL\nGOTO Loop","ScreenWidth":null,"ScreenHeight":null,"Sprites":null,"MapWidth":null,"MapHeight":null,"MapData":null}